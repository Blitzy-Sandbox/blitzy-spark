          "rules": [
            {
              "fullDescription": {
                "text": "In Java, it is recommended that constructors and methods clone any arrays received through parameters. This practice prevents the original array from being affected by any future changes made by the caller.\n\nIt is advisable to clone the array before storing it to ensure that you retain a copy of the array that will remain unaffected by any external changes made to the original array. By following this approach, you can promote code safety and maintain the integrity of the original array."
              },
              "helpUri": "https://docs.datadoghq.com/static_analysis/rules/java-best-practices/array-is-stored-directly",
              "id": "java-best-practices/array-is-stored-directly",
              "properties": {
                "tags": [
                  "DATADOG_RULE_TYPE:STATIC_ANALYSIS"
                ]
              },
              "shortDescription": {
                "text": "Should clone array"
              }
            },
            {
              "fullDescription": {
                "text": "This rule aims to discourage the direct propagation or usage of exception messages in the code. Exception messages can often contain sensitive or implementation-specific information that should not be exposed or relied upon for program logic. Relying on exception messages can lead to fragile code that breaks if the message text changes in future library or framework updates.\n\nTo comply with this rule, handle exceptions by using their types, custom error codes, or well-defined error objects instead of their message strings. For example, instead of `e.getMessage()`, consider catching specific exception subclasses or defining your own error classification. This approach leads to cleaner, more reliable error handling and protects sensitive information.\n\nExample of compliant handling: `catch (SpecificException ex) { log(\"Known error occurred\"); }` rather than inspecting `ex.getMessage()` contents."
              },
              "helpUri": "https://docs.datadoghq.com/static_analysis/rules/java-best-practices/avoid-propagate-exception-info",
              "id": "java-best-practices/avoid-propagate-exception-info",
              "properties": {
                "severity": "Moderate",
                "tags": [
                  "DATADOG_RULE_TYPE:STATIC_ANALYSIS"
                ]
              },
              "shortDescription": {
                "text": "Avoid propagation exception messages"
              }
            },
            {
              "fullDescription": {
                "text": "In Java, it is suggested to call `super()` in an extended class. This rule will report a violation if both a call to `super()` and an overloaded constructor are absent."
              },
              "helpUri": "https://docs.datadoghq.com/static_analysis/rules/java-code-style/call-super-in-constructor",
              "id": "java-code-style/call-super-in-constructor",
              "properties": {
                "problem": {
                  "severity": "HIGH"
                },
                "tags": [
                  "DATADOG_RULE_TYPE:STATIC_ANALYSIS"
                ]
              },
              "shortDescription": {
                "text": "Consider calling super in constructor"
              }
            },
            {
              "fullDescription": {
                "text": "This rule identifies when exceptions are raised within a `catch` block but are not relevant to the exception parameter specified in the `catch` block. This can result in the original exception's stack trace information being lost, which leads to throwing less detailed exceptions."
              },
              "helpUri": "https://docs.datadoghq.com/static_analysis/rules/java-best-practices/preserve-stack-trace",
              "id": "java-best-practices/preserve-stack-trace",
              "properties": {
                "problem": {
                  "severity": "CRITICAL"
                },
                "severity": "LOW",
                "tags": [
                  "DATADOG_RULE_TYPE:STATIC_ANALYSIS"
                ]
              },
              "shortDescription": {
                "text": "Preserve the thrown stack trace"
              }
            },
            {
              "fullDescription": {
                "text": "Ensure that a class has an `__init__` method. This check is bypassed for dataclass-like decorators (`@dataclass`, `@frozen`, `@bindable_dataclass`)."
              },
              "helpUri": "https://docs.datadoghq.com/static_analysis/rules/python-best-practices/init-method-required",
              "id": "python-best-practices/init-method-required",
              "properties": {
                "severity": "NOTICE",
                "tags": [
                  "DATADOG_RULE_TYPE:STATIC_ANALYSIS"
                ]
              },
              "shortDescription": {
                "text": "ensure classes have an __init__ method"
              }
            }
          ],
          "version": "0.9.1"
        }
