STEP 7 - The normalized comparison, using the wrapper's own version() definition
================================================================================
$ set -u
version() { echo "$@" | awk -F. '{ printf("%03d%03d%03d\n", $1,$2,$3); }'; }
MVN_VERSION=$(grep '<maven.version>' '/tmp/blitzy/scratch/f38258d3-f87d-44f5-bedc-af512c69e0ab/w-005/build/spark-src/pom.xml' | head -n1 | awk -F '[<>]' '{print $3}')
MVN_DETECTED_VERSION=$(mvn --version | head -n1 | awk '{print $3}')
printf 'required=%s normalized=%s\n' "$MVN_VERSION" "$(version $MVN_VERSION)"
printf 'detected=%s normalized=%s\n' "$MVN_DETECTED_VERSION" "$(version $MVN_DETECTED_VERSION)"
if [ $(version $MVN_DETECTED_VERSION) -ne $(version $MVN_VERSION) ]; then
  echo 'DOWNLOAD_BRANCH_TAKEN=yes -- HALT'
else
  echo 'comparison exited 1: DOWNLOAD_BRANCH_TAKEN=no'
fi
