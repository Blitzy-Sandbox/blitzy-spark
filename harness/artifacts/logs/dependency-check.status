flags_summary_printed_by_runner=--noupdate --disableOssIndex --prettyPrint --format JSON
flags_passed=--project spark-pinned-59b8a4489c878fa3a9aa6b7fbae760f2fc80eb9d | --noupdate | --disableOssIndex | --data /opt/blitzy-harness/dc-data | --scan <one absolute allowlist directory> x 18 | --format JSON | --prettyPrint | --out $HARNESS_LOG_DIR/dependency-check.out
flags_update_suppression_present=--noupdate
flags_analyzer_disable_present=--disableOssIndex
flags_disable_oss_index_note=PASSED HERE, which contradicts the harness precedent that omitted it. The runner gives its own reason at lines 5-7: Sonatype OSS Index no longer answers anonymously and 13.0.0 self-disables the analyzer with 'Authentication with token is now required', so passing the flag makes the disabling this harness's own and recorded rather than incidental. Recorded as read, not as expected.
flags_not_passed=--nvdApiKey | --purge | --update-only | --disableRetireJS | --disableNodeJS | --disableNodeAudit | --enableExperimental | --failOnCVSS | --suppression
flags_not_passed_consequences=--disableRetireJS absent, so the RetireJS analyzer RAN, offline against the seeded jsrepository.json; --disableNodeJS and --disableNodeAudit absent, so the Node Package Analyzer ran and produced the two reach warnings quoted below; --enableExperimental absent, so no experimental analyzer contributed; --failOnCVSS absent, so the exit code reflects the run rather than a policy; --suppression absent, so only the feed's own publishedSuppressions.xml applies
flags_anchor_status=none of these flags appears in the AAP expected-values table, so none is an anchor
flags_source=harness/bin/run-dependency-check.sh lines 51-57, corroborated by the /proc argv in the stdout log APPENDIX E
