jdk_major_source=observed
jdk_home=/opt/blitzy-tools/jdk/jdk-17.0.20+8
jdk_version_string=openjdk version "17.0.20" 2026-07-21
jdk_build=Temurin-17.0.20+8
jdk_reading_1_runner_text=harness/bin/run-dependency-check.sh line 51 invokes the tool with JAVA_HOME="$JAVA_HOME"; harness/env.sh line 47 sets JAVA_HOME to /opt/blitzy-tools/jdk/jdk-17.0.20+8; the runner's header line 8 states 'Runs under JAVA_HOME (Temurin 17) - JDK 21 is reserved for Joern'; the runner prints the home it assigned on its own stdout
jdk_reading_2_jdk_measured=$JAVA_HOME/bin/java -version, re-run in this checkout, printed 'openjdk version "17.0.20" 2026-07-21' and 'Temurin-17.0.20+8', exit 0
jdk_reading_3_running_process=the JVM that ran the scan, sampled from /proc at 2026-08-24T22:38:56+00:00, pid 452914, /proc/452914/exe = /opt/blitzy-tools/jdk/jdk-17.0.20+8/bin/java (stdout log APPENDIX E); only exe and argv were read, never /proc/*/environ
jdk_major_matches_runner_metadata=true
jdk_major_misassignment_halt_applies=false
jdk_major_misassignment_halt_note=AAP 0.9.2 halts on a MAJOR misassignment - the build on anything but 17, or any Joern invocation on anything but 21. Dependency-Check is neither, so its assignment is a property of the provisioned runner and the observed value equals the recorded one. A patch-level difference would have been recorded with both values and the run would continue.
heap_bound_jvm=false
heap_bound_jvm_note=The four heap-bound JVM invocations are the jimple2cpg frontend build, the importCpg verification load, the Stage 3 Joern runner and the Stage 5 probe (AAP 0.5.4). This runner sets no JAVA_OPTS and its argv carries no -Xmx, so the >= 64 GB rule does not apply and no heap is claimed.
heap_flag_passed=none
