smoke_override=unset
smoke_override_note=scan_root_source is SPARK_SRC rather than a smoke target. A runner shown to have resolved another tree, or to have run under the smoke override, halts the run (AAP 0.9.2); neither holds here
path_base_kind=scan_root
path_base_value=/opt/spark-src
path_base_record_field=the enclosing Results[].Target, refined by a per-record path or StartLine where the section supplies one
path_base_parts_caveat=the 18 retained per-directory reports under $HARNESS_LOG_DIR/trivy.parts/ are not root-anchored: each states Target relative to its own single path argument, so they must be read with per-section target semantics rather than with this base
scope_dirs=18
allowlist=harness/scope/allowlist.txt
allowlist_sha256=0013edf6cdc3a48d69aed5d7db41cc6647cfd461d348f5e1d563ba85664143d1
allowlist_role=the twelve globs decide in_scope alone. This runner also reads their expansion to shape its own reach, which is a fact about its reach rather than a change to the file; the allowlist stayed byte-exact
reach_caveat=the twelve roots hold zero resolvable dependency manifests - the one manifest-shaped in-scope file, core/src/main/resources/org/apache/spark/ui/static/package.json, declares no dependencies - so the vulnerability scanner had nothing in scope to resolve. That is a property of the scope, not of the installation
jdk_major=none
jdk_major_evidence=no JVM: /opt/blitzy-tools/bin/trivy is a statically linked ELF binary and the runner exports no JAVA_HOME. The 'java DB' it consults is a vulnerability database for Java artifacts rather than a Java runtime
heap_override=none
interpreter=/usr/bin/python3
interpreter_version_observed=3.13.7
interpreter_version_expected=3.13.7
interpreter_version_matches=true
interpreter_role=post-processing only - the two database metadata reads at lines 52-53 and the merge at lines 78-119. The scanner itself is a native binary
credential_expression=none
credential_expression_evidence=this runner calls scope_cred_state nowhere and prints no credential line, because trivy reads no credential in this configuration. Recorded as none rather than as an empty value
credentials_expected_absent=SEMGREP_APP_TOKEN, DD_API_KEY, DD_APP_KEY, NVD_API_KEY and any Sonatype OSS Index credential; none is read by this runner and none is provisioned by this run
secret_values_present=false
secret_values_note=this record carries no finding content, so no secret value and no credential value appears anywhere in it
verification_independence=the exit code, both timestamps and the elapsed time are measured from the process and read from the runner's own trailer; the section counts belong to the artifact and are attributed to it. Nothing here is verified against itself
