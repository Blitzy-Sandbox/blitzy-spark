feed_vuln_db_timestamp_matches=false
feed_java_db_expected=v1, 2026-08-23T01:05:59Z
feed_java_db_observed=v1 UpdatedAt=2026-08-24T01:07:04.599776272Z
feed_java_db_version_matches=true
feed_java_db_timestamp_matches=false
feed_identity_matches_expected=false
feed_difference_detail=both database versions match the expected identity (v2 and v1); both UpdatedAt timestamps are one day later than the AAP 0.4.2 expected identity. Both values are recorded and the run continues (AAP 0.9.3)
feed_authority_note=the request's expected-values table governs the field it carries. harness/ENVIRONMENT.md lines 112-113 records the same 2026-08-24 timestamps this run observed, so the inherited record agrees with observation and differs from the table; that is recorded with both values rather than adjudicated
not_comparable_with_rehearsal=true
not_comparable_reason=a feed one day newer resolves a different advisory set, so this tool's counts differ for reasons that have nothing to do with the code. Trivy's counts are marked not comparable with the rehearsal here, in oss-scan-results/tool-status.md, in oss-scan-results/severity-map.md and in the validation criteria
feed_state=not attempted
feed_state_vocabulary=attempted and succeeded | attempted and failed | not attempted | not reported (AAP 0.4.2); this outcome is the third
feed_state_derivation=the runner bakes --skip-db-update, --skip-java-db-update and --skip-check-update (run-trivy.sh line 70, summarised at trivy.stdout.log line 12), so no refresh was attempted and the seeded caches were used as found
feed_flag_policy=the flag set is recorded exactly as read from the provisioned runner; this run neither added, removed nor forced any of it, and no runner file or baked flag was edited (AAP 0.4.2, 0.8.1)
feed_fetched_at_scan_time=false
feed_offline_scan=true
feed_offline_scan_note=--offline-scan is baked in, so no Maven Central resolution occurs at scan time; harness/ENVIRONMENT.md records an earlier provisioning run without it taking '429 Too Many Requests, Retry-After: 1800' and writing no artifact at all
sections_supported=Vulnerabilities,Secrets,Misconfigurations
sections_count_unit=Results[] x (Vulnerabilities|Secrets|Misconfigurations): one element of one of those three arrays is one record (AAP 0.5.4)
