record_kind=per-invocation runner status record for one of the nine scanners (AAP 0.6.1)
record_filename_convention=<tool>.status, the name AAP 0.6.1 specifies; deliberately not the harness precedent's <tool>.meta.json
record_format=flat key=value, one pair per line, split on the first '='. That is the shape harness/lib/scope.sh scope_finish writes and harness/lib/normalize/cli.py _runner_status reads; the seven lines above are that record in its own key order and every line below extends it without displacing it
canonical_tool_identifier=trivy
canonical_tool_identifier_source=the AAP 0.5.4 class table, produced from the stem of the runner and its artifact rather than from a product name
scanner_class=per-record: vuln, secret or misconfig, taken from the section array the record was read from
scanner_class_is_single_value=false
scanner_class_varies_per_record=true
scanner_class_permitted_values=vuln,secret,misconfig
scanner_class_derivation=strictly from which of Results[].Vulnerabilities[], Results[].Secrets[] or Results[].Misconfigurations[] a record was read from - never from the record's own content
scanner_class_note=trivy is the single tool in the AAP 0.5.4 class table whose scanner_class is not fixed per tool, which is why this record carries a per-section breakdown rather than one class
runner=/tmp/blitzy/blitzy-spark/blitzy-f38258d3-f87d-44f5-bedc-af512c69e0ab-w-028_dc8c3c/harness/bin/run-trivy.sh
runner_repo_relative=harness/bin/run-trivy.sh
runner_absolute_path_derivation=the runner resolves its own location and derives the harness directory from it, so the log directory it printed at trivy.stdout.log line 4 identifies the checkout it ran in; the absolute path above is that checkout's harness/bin/run-trivy.sh
runner_script_classification=runner
runner_inventory_context=harness/bin/ holds exactly the nine runners the AAP 0.5.4 class table names and no orchestrator
invoked_directly=true
invoked_with_arguments=none
invoked_one_at_a_time=true
invoked_through_orchestrator=false
invocation_discipline=invoked directly, with no arguments, one at a time, never through an orchestrator (AAP 0.8.1). An orchestrator's continue-on-error sequencing would carry the run past a condition that must halt it and would collapse per-tool attribution
argument_guard=run-trivy.sh lines 22-25 print 'run-trivy.sh: takes no arguments (configuration is baked in); refusing to scan' to stderr and exit 64
argument_guard_precedes_all_scanning_steps=true
argument_guard_established_by=inspection: the guard is the first executable statement, and environment sourcing (line 30), shared-library sourcing (32), target resolution (45) and the first tool invocation (67) all follow it
argument_guard_rejection_probe_performed=false
argument_guard_rejection_probe_reason=inspection settled the ordering, so no probe was needed; a blind probe against a defective runner could have performed a real scan and contaminated the artifact tree
started_at=2026-08-24T22:34:30Z
finished_at=2026-08-24T22:35:07Z
started_at_log_literal=2026-08-24T22:34:30+00:00
finished_at_log_literal=2026-08-24T22:35:07+00:00
timestamps_provenance=trivy.stdout.log lines 7 and 37, written by scope_begin and scope_finish; the Z forms above are the same two instants in ISO 8601 UTC
elapsed_seconds_provenance=trivy.stdout.log line 35 ('elapsed seconds : 37')
elapsed_seconds_internal_check=finished_at minus started_at is 37 s, equal to the recorded elapsed_seconds
elapsed_seconds_expected=17
elapsed_seconds_observed=37
elapsed_seconds_expected_source=harness/ENVIRONMENT.md section 9 line 472
elapsed_seconds_comparison=recorded as expected against observed and nothing else (AAP 0.9.3). No time limit applies to this run and no budget is asserted: elapsed time is a fact (AAP 0.8.1)
termination_and_exit_status_rule=the process reported an exit code, so exit_code above is the single terminal field and no exit_status field is written. 'exit_status: timeout' is the one name AAP 0.8.1 gives a termination that produced no exit code; it names the status only, excuses nothing, and does not apply here
exit_code_provenance=trivy.stdout.log line 34 ('exit code : 0')
exit_code_aggregation=run-trivy.sh keeps the worst non-zero exit across its invocations (line 75) and exits with it (line 124); all 18 per-directory invocations printed exit=0 at lines 14-31, so the tool's own aggregate is 0
exit_code_use=recorded as a fact and used for nothing else. Artifact status and exit status are independent (AAP 0.5.4): a non-zero exit from a tool that wrote a parsable artifact is ordinary, and a zero exit is not itself evidence about the artifact
artifact_repo_relative=harness/artifacts/raw/trivy.json
artifact_expected=true
artifact_observed_present=true
artifact_presence_evidence=trivy.stdout.log line 36 records a byte count rather than the literal MISSING, and scope_finish prints stat -c%s of the artifact where the file exists and MISSING where it does not
artifact_bytes_provenance=trivy.stdout.log line 36 ('... (3496 bytes)'). One measurement cited twice: every document carrying this size cites that line rather than measuring again (AAP 0.6.4)
artifact_bytes_expected=3496
artifact_bytes_expected_source=harness/ENVIRONMENT.md section 9 line 472 (3,496)
artifact_bytes_comparison=expected 3496, observed 3496, equal
artifact_format=native JSON, SchemaVersion 2
artifact_shape=native: it carries no version '2.1.0' with a runs array, so it routes to the trivy native adapter rather than to the shared SARIF adapter
artifact_assembly=the 18 per-directory reports retained under $HARNESS_LOG_DIR/trivy.parts/ are merged by run-trivy.sh lines 78-119 into one report whose Results[] is the concatenation of every part's sections, each Target root-anchored by prefixing that part's own ArtifactName, and the merged ArtifactName set to '.'
artifact_local_presence_in_this_clone=absent when this record was written
artifact_local_presence_note=the invocation ran in the checkout named in the artifact path above and wrote the artifact there. harness/artifacts/raw/trivy.json is its own AAP 0.6.1 CREATE row, generated after this record, so this clone's raw tree did not yet hold it. The byte size recorded here is the runner's own stat measurement, which this folder owns and raw/ conforms to
artifact_parse_status_owner=harness/artifacts/logs/normalize-run.json and oss-scan-results/tool-status.md; parse status is normalization's measurement rather than this record's
version_expected=0.74.0
version_observed=0.74.0
version_matches_expected=true
version_evidence=`trivy --version` printed 'Version: 0.74.0', recorded at the gate in harness/artifacts/logs/gate-record.json check gate.tool_version.trivy, resolved path /opt/blitzy-tools/bin/trivy
version_difference_policy=a version differing from the expected 0.74.0 would be recorded with both values and the run would continue (AAP 0.9.3); no difference was observed
feed_kind=vulnerability feeds, seeded local caches
feed_location=/opt/blitzy-harness/trivy-cache
feed_measurement_source=trivy.stdout.log lines 9-10, printed by run-trivy.sh lines 52-53 from $TRIVY_CACHE_DIR/db/metadata.json and $TRIVY_CACHE_DIR/java-db/metadata.json. This record cites that one measurement and takes no second one (AAP 0.6.4)
