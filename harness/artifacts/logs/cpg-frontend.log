STEP 8 - Independent bidirectional re-proof of the documented invocation's input set
  Not a quotation. This recomputes every digest by reading the 62 staged files
  and checks the mapping in both directions here, now, so the precondition for
  the invocation this file documents is established by measurement rather than
  accepted on trust.

$ python3 - <<'PY'
  # Independent bidirectional totality-and-injectivity check of the DOCUMENTED invocation's
  # input set: the manifest of record against the staging directory the frontend was given.
  # Digests are recomputed here by reading each staged file; nothing is taken on trust.
  import json, os, hashlib, collections
  INV = "/opt/blitzy-harness/provision-log/cpg-input-inventory.json"
  inv = json.load(open(INV)); sd = inv["staging_dir"]
  entries = inv["included"]
  on_disk = sorted(f for f in os.listdir(sd) if os.path.isfile(os.path.join(sd, f)))
  def sha(p):
      h = hashlib.sha256()
      with open(p, "rb") as f:
          for b in iter(lambda: f.read(1 << 20), b""): h.update(b)
      return h.hexdigest()
  print("manifest entries          :", len(entries))
  print("files in staging directory :", len(on_disk))
  print("distinct staged names      :", len({e["staged"] for e in entries}))
  recomputed = {n: sha(os.path.join(sd, n)) for n in on_disk}
  print("distinct sha256 (recomputed from the staged files):", len(set(recomputed.values())))
  fwd_unmapped = [e["staged"] for e in entries if e["staged"] not in recomputed]
  rev_unmapped = [n for n in on_disk if n not in {e["staged"] for e in entries}]
  mismatch = [(e["staged"], e["sha256"], recomputed.get(e["staged"]))
              for e in entries if recomputed.get(e["staged"]) != e["sha256"]]
  dupname = [k for k, v in collections.Counter(e["staged"] for e in entries).items() if v > 1]
  print("direction manifest -> staged : total =", not fwd_unmapped, " injective =", not dupname,
        " mapped =", len(entries) - len(fwd_unmapped), " unmapped =", fwd_unmapped)
  print("direction staged -> manifest : total =", not rev_unmapped,
        " mapped =", len(on_disk) - len(rev_unmapped), " unmapped =", rev_unmapped)
  print("digest mismatches            :", len(mismatch), mismatch)
  groups = collections.defaultdict(list)
  for n, d in recomputed.items(): groups[d].append(n)
  coll = {d: sorted(v) for d, v in groups.items() if len(v) > 1}
  print("sha256 collision groups      :", len(coll), coll)
  print("RESULT: total and injective in both directions =", not fwd_unmapped and not rev_unmapped and not dupname and not mismatch)
  print("bytes in the staging directory:", sum(os.path.getsize(os.path.join(sd, n)) for n in on_disk))
  PY
