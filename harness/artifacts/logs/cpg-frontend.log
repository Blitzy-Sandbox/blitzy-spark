  	at scala.util.Try$.apply(Try.scala:195)
  	at scala.util.Success.map(Try.scala:248)
  	at io.joern.x2cpg.X2CpgFrontend.run(X2Cpg.scala:236)
  	at io.joern.x2cpg.X2CpgFrontend.run$(X2Cpg.scala:222)
  	at io.joern.jimple2cpg.Jimple2Cpg.run(Jimple2Cpg.scala:27)
