  Why the overwrite count is high, measured rather than asserted: this input set
  contains duplicate class names by design. Each module contributes both its
  shaded artifact and its 'original-' pre-shade sibling, and those two duplicate
  every class between them; shaded artifacts additionally vendor the same
  third-party classes as one another. The grouping below separates those two
  situations.

STEP 40 - Both metrics grouped by the module and artifact the affected classes are CONTAINED IN
  Containment is measured by reading the entry list of every staged archive. The
  program is shown in full so the tables can be reproduced. Read the labels
  literally: this is containment, NOT provenance - see THE LIMITATION below.

$ python3 - <<'PY'
  # Groups the frontend's two observed metrics by the module and artifact the affected
  # class files are CONTAINED IN. Containment is measured by reading every staged input
  # archive's entry list. It is NOT provenance: the frontend's warning names the
  # DESTINATION class, never the archive whose definition survived.
  import json, re, zipfile, collections, os
  LOG = "/opt/blitzy-harness/provision-log/cpg-frontend.log"
  INV = "/opt/blitzy-harness/provision-log/cpg-input-inventory.json"
  inv = json.load(open(INV)); staged = inv["staging_dir"]
  ow_re  = re.compile(r"Overwriting class file: /tmp/jimple2cpg-\d+/(.*)$")
  ast_re = re.compile(r"Exception on AST creation for /tmp/jimple2cpg-\d+/(.*)$")
  ow = collections.Counter(); ast = []
  for line in open(LOG, errors="replace"):
      m = ow_re.search(line)
      if m: ow[m.group(1)] += 1; continue
      m = ast_re.search(line)
      if m: ast.append(m.group(1))
  owner = collections.defaultdict(list)          # entry name -> [(module, staged archive)]
  for e in inv["included"]:
      with zipfile.ZipFile(os.path.join(staged, e["staged"])) as z:
          for n in z.namelist(): owner[n].append((e["module"], e["staged"]))
  def pkg(p):
      q = p.split("/")
      if q[0] == "META-INF": return "META-INF/**"
      for d in (3, 2, 1):
          if len(q) > d: return "/".join(q[:d]) + "/**"
      return p
  print("A. OVERWRITTEN DESTINATIONS BY DESTINATION PACKAGE")
  print("   %-34s %10s %10s" % ("destination package", "distinct", "warnings"))
  a = collections.Counter(); b = collections.Counter()
  for c, n in ow.items(): a[pkg(c)] += 1; b[pkg(c)] += n
  for k in sorted(a, key=lambda k: -b[k]): print("   %-34s %10d %10d" % (k, a[k], b[k]))
  print("   %-34s %10d %10d" % ("TOTAL", sum(a.values()), sum(b.values())))
  print()
  print("B. OVERWRITTEN DESTINATIONS BY CONTAINING MODULE SET (containment, not provenance)")
  g = collections.Counter(); gl = collections.Counter(); intra = multi = cross = 0; unmatched = []
  for c, n in ow.items():
      o = owner.get(c)
      if not o: unmatched.append((c, n)); continue
      mods = tuple(sorted({m for m, _ in o})); arts = {a2 for _, a2 in o}
      g[mods] += 1; gl[mods] += n
      if len(mods) == 1:
          intra += 1
          if len(arts) > 1: multi += 1
      else: cross += 1
  print("   %-62s %8s %8s" % ("containing module set", "distinct", "warnings"))
  for k in sorted(g, key=lambda k: -g[k]): print("   %-62s %8d %8d" % (" + ".join(k), g[k], gl[k]))
  print()
  print("   destinations contained in exactly ONE module's artifacts      : %d" % intra)
  print("     of those, contained in MORE THAN ONE artifact of that module: %d" % multi)
  print("   destinations contained in MORE THAN ONE module's artifacts    : %d" % cross)
  print("   destinations matching no entry name in any staged archive     : %d  %s" % (len(unmatched), [u[0] for u in unmatched]))
  print()
  print("C. MOST-REPEATED DESTINATIONS (a destination overwritten k times was supplied k+1 times)")
  for k, v in ow.most_common(8): print("   %5d  %s" % (v, k))
  print()
  print("D. MULTI-RELEASE module-info.class ENTRIES PRESENT IN THE INPUT (explains the unmatched destination)")
  for e in inv["included"]:
      with zipfile.ZipFile(os.path.join(staged, e["staged"])) as z:
          for n in z.namelist():
              if n.endswith("module-info.class"): print("   %-24s %-58s %s" % (e["module"], e["staged"], n))
  print()
  print("E. AST-CREATION FAILURES: EVERY AFFECTED CLASS, GROUPED BY CONTAINING MODULE SET AND ARTIFACT")
  by = collections.defaultdict(list)
  for c in ast:
      o = owner.get(c, [])
      by[(tuple(sorted({m for m, _ in o})), tuple(sorted({a2 for _, a2 in o})))].append(c)
  tot = 0
  for (mods, arts), classes in sorted(by.items(), key=lambda kv: -len(kv[1])):
      print("   module set : %s" % (" + ".join(mods) or "<contained in no staged archive>"))
      for a2 in arts: print("   artifact   : %s" % a2)
      print("   classes    : %d" % len(classes)); tot += len(classes)
      for c in sorted(classes): print("       %s" % c)
      print()
  print("   TOTAL AST-creation failures accounted for: %d" % tot)
  print()
  print("F. THE THREE CLASSES THE SHIMS ARTIFACT ALSO SHIPS, MEASURED IN THIS INPUT SET")
  for probe in ("org/apache/spark/SparkConf.class", "org/apache/spark/SparkContext.class", "org/apache/spark/rdd/RDD.class"):
      o = owner.get(probe, [])
      print("   %-38s warnings=%d  containing artifacts=%d  modules=%s"
            % (probe, ow.get(probe, 0), len(o), sorted({m for m, _ in o}) or "-"))
      for m, a2 in sorted(o): print("       %-22s %s" % (m, a2))
  print()
  print("G. INPUT-SET ENTRY TOTALS, COUNTED FROM THE ARCHIVES THEMSELVES")
  tot_e = tot_c = 0
  for e in inv["included"]:
      with zipfile.ZipFile(os.path.join(staged, e["staged"])) as z:
          names = z.namelist()
      tot_e += len(names); tot_c += sum(1 for n in names if n.endswith(".class"))
  print("   staged archives: %d   zip entries: %d   of which .class: %d" % (len(inv["included"]), tot_e, tot_c))
  PY
