CHECK : COMPARISON against the pair recorded at write time - equality of BOTH values is the pass condition
$ bash -c 
  exp_bytes=541255894
  exp_sha=26d327ccee096aa4c8d67018b32669f2a318331cf873922286774734177fcffc
  obs_bytes=$(stat -Lc %s harness/cpg/spark.cpg)
  obs_sha=$(sha256sum -- "$(readlink -f harness/cpg/spark.cpg)" | cut -d" " -f1)
  printf "expected bytes  : %s\nobserved bytes  : %s\nbytes match     : %s\n" "$exp_bytes" "$obs_bytes" "$([ "$exp_bytes" = "$obs_bytes" ] && echo YES || echo NO)"
  printf "expected sha256 : %s\nobserved sha256 : %s\nsha256 match    : %s\n" "$exp_sha" "$obs_sha" "$([ "$exp_sha" = "$obs_sha" ] && echo YES || echo NO)"
  if [ "$exp_bytes" = "$obs_bytes" ] && [ "$exp_sha" = "$obs_sha" ]; then
    printf "VERDICT         : PASS - the bytes this runner will load are the bytes the record describes\n"; exit 0
  else
    printf "VERDICT         : HALT - identity mismatch; a load against different bytes than the record describes produces conclusions about a graph nobody has\n"; exit 1
  fi
