================================================================================
STEP 13 - Each project's own artifact ON DISK, independent of Maven's summary
================================================================================
A SUCCESS line says Maven's package phase completed; it does not say a file exists,
and for two projects it does not say where. So the outcome is established a second
time, from the filesystem, by provenance rather than by location: a file counts as a
project's own only when its name carries that project's own artifactId and this
build's version, optionally with an 'original-' prefix (the pre-shade sibling) or a
classifier suffix. Everything else under the same build directory is a copied
dependency and is counted and excluded, because pom.xml's copy-module-dependencies
writes third-party jars into the very same jars.target.dir that examples publishes
its main artifact to - so location alone would misattribute both directions.

The classifier is reproduced verbatim so the classification can be checked rather
than trusted:

    #!/usr/bin/env python3
    """Independent on-disk verification of each reactor project's OWN artifact.
    
    Reads each module's own <artifactId> out of its pom (the first artifactId that is
    not inside the <parent> block), enumerates every *.jar under that module's build
    directory, and classifies each file as the project's own -- its filename carries
    that project's artifactId and version, optionally with an 'original-' prefix or a
    classifier suffix -- or as a copied dependency, which carries some other
    coordinate. Location alone is not sufficient evidence and is not used as such.
    """
    import hashlib
    import os
    import re
    import sys
    
    TREE = sys.argv[1]
    VERSION = "4.1.0-SNAPSHOT"
    
    PARENT_BLOCK = re.compile(r"<parent>.*?</parent>", re.S)
    ARTIFACT_ID = re.compile(r"<artifactId>([^<]+)</artifactId>")
    MODULE = re.compile(r"<module>([^<]+)</module>")
    
    
    def own_artifact_id(pom_path):
        with open(pom_path, encoding="utf-8") as fh:
            text = fh.read()
        stripped = PARENT_BLOCK.sub("", text, count=1)
        match = ARTIFACT_ID.search(stripped)
        if not match:
            raise SystemExit("no artifactId in %s" % pom_path)
        return match.group(1)
    
    
    def packaging(pom_path):
        with open(pom_path, encoding="utf-8") as fh:
            text = fh.read()
        stripped = PARENT_BLOCK.sub("", text, count=1)
        match = re.search(r"<packaging>([^<]+)</packaging>", stripped)
        return match.group(1) if match else "jar"
    
    
    def sha256(path):
        digest = hashlib.sha256()
        with open(path, "rb") as fh:
            for chunk in iter(lambda: fh.read(1 << 20), b""):
                digest.update(chunk)
        return digest.hexdigest()
    
    
    root_pom = os.path.join(TREE, "pom.xml")
    with open(root_pom, encoding="utf-8") as fh:
        root_text = fh.read()
    unconditional = MODULE.findall(root_text[root_text.index("<modules>"):root_text.index("</modules>")])
    profile_added = [
        "resource-managers/yarn",
        "common/network-yarn",
        "resource-managers/kubernetes/core",
        "sql/hive-thriftserver",
    ]
    projects = [("(root parent)", root_pom)] + [
        (m, os.path.join(TREE, m, "pom.xml")) for m in unconditional + profile_added
    ]
    
    jar_projects = 0
    pom_projects = 0
    produced = 0
    missing = []
    rows = []
    for module, pom in projects:
        aid = own_artifact_id(pom)
        pkg = packaging(pom)
        build_dir = os.path.join(os.path.dirname(pom), "target")
        own, copied = [], 0
        for dirpath, _dirnames, filenames in os.walk(build_dir):
            for name in filenames:
                if not name.endswith(".jar"):
                    continue
                base = name[:-4]
                stem = base[len("original-"):] if base.startswith("original-") else base
                if stem == "%s-%s" % (aid, VERSION) or stem.startswith("%s-%s-" % (aid, VERSION)):
                    own.append(os.path.join(dirpath, name))
                elif module == "common/network-yarn" and name == "spark-%s-yarn-shuffle.jar" % VERSION:
                    own.append(os.path.join(dirpath, name))
                else:
                    copied += 1
        own.sort()
        main = [p for p in own
                if os.path.basename(p) == "%s-%s.jar" % (aid, VERSION)]
        if pkg == "pom":
            pom_projects += 1
        else:
            jar_projects += 1
            if main:
                produced += 1
            else:
                missing.append(module)
        rows.append((module, aid, pkg, own, main, copied))
    
    print("PROJECTS ENUMERATED FROM THE POMS: %d  (jar-packaging %d, pom-packaging %d)"
          % (len(projects), jar_projects, pom_projects))
    print("JAR-PACKAGING PROJECTS WITH THEIR OWN MAIN ARTIFACT ON DISK: %d of %d"
          % (produced, jar_projects))
    print("JAR-PACKAGING PROJECTS WITH NO OWN MAIN ARTIFACT: %s"
          % (", ".join(missing) if missing else "(none)"))
    print()
    for module, aid, pkg, own, main, copied in rows:
        print("PROJECT   %s" % module)
        print("  artifactId %s   packaging %s" % (aid, pkg))
        if pkg == "pom":
            print("  own artifact: NONE - EXPECTED, packaging=pom")
        for path in own:
            rel = os.path.relpath(path, TREE)
            tag = "MAIN" if path in main else "also"
            print("  %s %s  %d bytes  sha256 %s" % (tag, rel, os.path.getsize(path), sha256(path)))
        if not own and pkg != "pom":
            print("  own artifact: NONE FOUND - UNESTABLISHED")
        print("  copied dependency jars under this build directory, excluded: %d" % copied)
        print()

