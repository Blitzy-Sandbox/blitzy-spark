================================================================================
STEP 10 - The invocation, quoted verbatim from the script that ran it
================================================================================
The build was run once, by the script below, from a detached session so that no
shell teardown could truncate the capture. The script is reproduced as it exists on
disk: it sources the harness environment, sets MAVEN_OPTS to the runbook's value,
invokes the wrapper with the five mandated profile flags and no module selector, and
records the start time, the end time, the exit status and the elapsed seconds as each
happens. stdout and stderr are merged into one capture file in the order the terminal
received them, and nothing filters that stream.

    #!/usr/bin/env bash
    # Runs the mandated full-reactor build once, capturing stdout and stderr merged,
    # verbatim, into build-reactor-verbatim.log. Nothing filters or reflows the stream.
    cd "/tmp/blitzy/blitzy-spark/blitzy-f38258d3-f87d-44f5-bedc-af512c69e0ab-w-017_83e3ba" || exit 90
    BLITZY_CLONE_INDEX=17 . harness/env.sh || exit 91
    cd "/tmp/blitzy-harness-scratch/17/build-reactor/spark-src" || exit 92
    export MAVEN_OPTS="-Xss64m -Xmx6g -Xms2g -XX:ReservedCodeCacheSize=512m"
    date -u +%Y-%m-%dT%H:%M:%S.%3NZ > "/tmp/blitzy-harness-scratch/17/build-reactor/build.start"
    S=$(date +%s)
    ./build/mvn --no-transfer-progress -DskipTests -Dmaven.repo.local="/tmp/blitzy-harness-scratch/17/build-reactor/m2-repo" \
      -Pyarn -Pkubernetes -Phive -Phive-thriftserver -Pvolcano package \
      > "/tmp/blitzy-harness-scratch/17/build-reactor/build-reactor-verbatim.log" 2>&1
    rc=$?
    E=$(date +%s)
    date -u +%Y-%m-%dT%H:%M:%S.%3NZ > "/tmp/blitzy-harness-scratch/17/build-reactor/build.end"
    printf '%s\n' "$rc" > "/tmp/blitzy-harness-scratch/17/build-reactor/build.rc"
    printf '%s\n' "$((E-S))" > "/tmp/blitzy-harness-scratch/17/build-reactor/build.elapsed"

