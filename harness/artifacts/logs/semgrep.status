# ---------------------------------------------------------------------------
credential_variable=SEMGREP_APP_TOKEN
credential_state=absent
credential_state_expression=scope_cred_state SEMGREP_APP_TOKEN at run-semgrep.sh line 45, which uses the set-arm form only (harness/lib/scope.sh lines 105-109) and prints exactly one of two fixed tokens.
credential_value_recorded=false
credential_value_policy=No credential value appears in this record, in either stream, or in the artifact. The form whose default arm echoes a variable's own value is never used, because these logs are preserved verbatim.

# ---------------------------------------------------------------------------
# The two streams this record is written against
# ---------------------------------------------------------------------------
stdout_log=harness/artifacts/logs/semgrep.stdout.log
stdout_log_bytes=40661230
stdout_log_sha256=96c7eb268cbc17eea688bbd3836b477a3846095f0dcaade7ff45451ac63b523d
stdout_log_content=The tool's own stdout, verbatim: the SARIF document. Measured byte-for-byte equal to harness/artifacts/raw/semgrep.sarif plus one trailing newline.
stdout_log_trailer_present=false
stdout_log_trailer_explanation=run-semgrep.sh line 65 redirects the tool's stdout into this file, so scope_finish's prose lines went to the runner's console stream instead. The absence is a property of which stream owns the file, and it is not evidence of a termination: the process ended with a code, on the evidence recorded above. Where a runner's tool prints nothing to stdout, the same file holds the console header and trailer instead, as harness/artifacts/logs/opengrep.stdout.log does.
stdout_log_trailer_cross_check=Each quantity a trailer would have carried is cross-checked here against an independent measurement: the exit code against the artifact's executionSuccessful and the tool's own summary; the elapsed seconds against scope_finish's arithmetic, which wrote the field above; the artifact byte count against a stat taken in this clone.
stderr_log=harness/artifacts/logs/semgrep.stderr.log
stderr_log_bytes=5079
stderr_log_sha256=ba65027215fa502812b57f0e42d02f8a160af187b932ea87aa9738970dbc0159
stderr_log_content=The tool's own stderr, verbatim: one internal-option warning, two ruleset include-pattern deprecation warnings, the scan-status table and the scan summary.
stated_reason_for_no_artifact=not applicable; the artifact is present

