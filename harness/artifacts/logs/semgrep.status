# harness/artifacts/logs/semgrep.status
#
# Structured per-invocation status record for the Semgrep runner over the pinned
# Apache Spark tree at 59b8a4489c878fa3a9aa6b7fbae760f2fc80eb9d.
#
# FORMAT. One field per line: a key, a single separator character, then the
# value. UTF-8, LF, no duplicate keys. A line without that separator is a
# comment and every reader skips it, which is why no comment in this file
# carries one. harness/lib/normalize/cli.py reads this file for the exit code,
# the elapsed seconds, the artifact byte count and the scan root, so those four
# keep the names and the values harness/lib/scope.sh gave them.
#
# PROVENANCE. The first block is the runner's own account, byte-for-byte as
# scope_finish wrote it (harness/lib/scope.sh lines 91-99). Everything after it
# is this record's own measurement, each line naming the evidence it rests on.
# Nothing here is filled in from a plausible value: a quantity that could not be
# established is named unestablished instead.

# ---------------------------------------------------------------------------
# The runner's own account, verbatim
# ---------------------------------------------------------------------------
tool=semgrep
exit_code=0
elapsed_seconds=621
artifact=/tmp/blitzy/blitzy-spark/blitzy-f38258d3-f87d-44f5-bedc-af512c69e0ab-w-024_691318/harness/artifacts/raw/semgrep.sarif
artifact_bytes=40661229
scan_root=/opt/spark-src
scan_root_source=SPARK_SRC

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
canonical_tool_identifier=semgrep
canonical_tool_identifier_derivation=Taken mechanically from the stem of the runner (harness/bin/run-semgrep.sh) and of its artifact (semgrep.sarif). A product name is never the identifier; the artifact's own SARIF driver string is recorded below as the tool describing itself.
scanner_class=sast
scanner_class_varies_per_record=false

# ---------------------------------------------------------------------------
# The runner, and how it was invoked
# ---------------------------------------------------------------------------
runner=harness/bin/run-semgrep.sh
runner_absolute_path_at_invocation=/tmp/blitzy/blitzy-spark/blitzy-f38258d3-f87d-44f5-bedc-af512c69e0ab-w-024_691318/harness/bin/run-semgrep.sh
runner_absolute_path_evidence=The artifact line above is the runner's own resolved $HARNESS_RAW_DIR/semgrep.sarif; harness/env.sh line 25 derives HARNESS_RAW_DIR from the harness directory of the checkout whose env.sh was sourced, and run-semgrep.sh line 16 sources env.sh from its own location, so that clone prefix names the checkout the runner ran from. Qualification, stated because it is knowable: every variable in env.sh honours a value already present, so an overridden HARNESS_RAW_DIR would make the prefix name the raw tree rather than the checkout.
runner_absolute_path_in_this_clone=/tmp/blitzy/blitzy-spark/blitzy-f38258d3-f87d-44f5-bedc-af512c69e0ab-w-000_2f473f/harness/bin/run-semgrep.sh
runner_sha256=4bc87e217e8760543805a6344b910895db51d036b96ca8944277d13749cc35f4
runner_sha256_scope=The runner file as it stands in this clone, git-tracked and unmodified. No runner file and no baked flag was edited; the only levers used are environment values the runners are written to consume.
invoked_directly=true
invocation_arguments=none
invocation_concurrency=one at a time WITHIN THIS CLONE; global sequencing across the run FAILED, and THIS invocation's own overlap status is NOT ESTABLISHED - see invocation_concurrency_correction
invocation_concurrency_superseded_value=one at a time
invocation_concurrency_correction=Direct invocation, no arguments and no orchestrator are unchanged: both were established by inspection of the runner and by this lane's own record. What the superseded value additionally asserted - one tool at a time - holds only inside the clone this runner ran in (w-024_691318). This record's started_at and finished_at are not-established, so this invocation's window cannot be compared with any other: whether it overlapped another tool is NOT ESTABLISHED and is named as such rather than assumed disjoint. The five overlapping pairs measured across the run are between other tools' windows. AAP 0.8.1's requirement is GLOBAL - each runner invoked directly and individually, with its output captured before the next is started - so this run records global sequencing as FAILED rather than satisfied. All five overlapping pairs are published once, in oss-scan-results/tool-status.md under "Facts common to all nine", and indexed in oss-scan-results/run-record.md section 8. semgrep.status records started_at and finished_at as not-established, so its window cannot be compared with any other and is excluded from the pair count rather than assumed disjoint. Nothing here was repaired: no invocation was re-run to obtain a disjoint window.
invoked_through_orchestrator=false
orchestrator_note=harness/bin carries the nine runners and no orchestrator, deliberately. Direct individual invocation is the requirement: an orchestrator's continue-on-error sequencing would carry a run past a condition that must stop it, and it would collapse per-tool attribution.
argument_guard=harness/bin/run-semgrep.sh lines 8-11, exit 64 with a diagnostic naming the refusal
argument_guard_precedes_scanning=true
argument_guard_established_by=inspection. The guard is the script's first executable statement, ahead of the environment sourcing at line 16, the shared library at line 18, target resolution at line 28 and the tool invocation at line 58. No rejection probe was run, none being needed once the ordering is settled by reading.
scan_target_variable=SPARK_SRC
scan_target_value=/opt/spark-src
scan_target_resolution=scope_resolve_target (harness/lib/scope.sh lines 22-35), called at run-semgrep.sh line 28. The target comes from the environment, never from the working directory.
scan_root_verified=true
scan_root_verification=git -C /opt/spark-src rev-parse HEAD is 59b8a4489c878fa3a9aa6b7fbae760f2fc80eb9d, the pin, re-checked in this clone.
smoke_override_state=unset
smoke_override_evidence=The scan root source above is SPARK_SRC, which is the branch scope_resolve_target takes only when HARNESS_SMOKE_TARGET is empty (harness/lib/scope.sh lines 22-33). A smoke target is setup-time verification only and is never a fallback for a real scan.
working_directory=/opt/spark-src
working_directory_source=cd "$SCAN_ROOT" at run-semgrep.sh line 47
path_base=/opt/spark-src
path_base_kind=scan_root
path_base_evidence=The invocation runs from the scan root with root-relative targets, so every SARIF uri is root-relative. The results carry uriBaseId %SRCROOT% with no run.originalUriBaseIds emitted, so the specification's base resolution cannot complete and this recorded base is the one available.
invocation_form=one invocation, many paths: the eighteen root-relative directories the allowlist expands to, passed together
invocation_source_lines=harness/bin/run-semgrep.sh lines 58-65
baked_flags=scan; one --config per rule-bearing ruleset directory; --sarif; --sarif-output; --metrics=off; --disable-version-check; --timeout 120; --timeout-threshold 0; --max-target-bytes 20000000; --x-ignore-semgrepignore-files; --oss-only
baked_flags_note=Read from the runner as provisioned, not assumed. None of them appears in the expected-values table, so none is an anchor. Nothing here added, removed or forced a flag.
ruleset_identity_observed=commit 40b8c63f75dc7c22c8a77482d73bfb864b146f7e at /opt/blitzy-harness/rules/semgrep-rules
ruleset_identity_expected=commit 40b8c63f75dc7c22c8a77482d73bfb864b146f7e
ruleset_identity_matches_expected=true
ruleset_counts_comparable_with_rehearsal=true

# ---------------------------------------------------------------------------
# How the process ended
# ---------------------------------------------------------------------------
exit_code_measurement=Captured from the process at run-semgrep.sh line 66, immediately after the invocation, and passed to scope_finish at line 69, which wrote the exit code field above. The runner exits with the tool's own code and does not transform it (line 70).
exit_code_expected=0
exit_code_agrees_with_expected=true
exit_code_cross_check_artifact=The artifact's own SARIF invocations entry reports executionSuccessful true, so the invocation the artifact describes is one that completed.
exit_code_cross_check_tool_words=The tool's own stderr summary states "Scan completed successfully." and closes "Ran 1238 rules on 4094 files: 1162 findings."
exit_code_cross_check_flags=No --error flag is baked into the invocation, so this engine's success code is not turned non-zero by the 1162 findings it reported. Where another runner in this harness exits non-zero because it found something, that code is likewise recorded as a fact.
exit_code_used_for=Nothing else. Artifact status and exit status are independent: the artifact verdict below rests on the bytes and the parse, and is reached without consulting this code.
termination_mode=exited with a code
termination_mode_evidence=scope_finish ran to completion. It wrote this file, and harness/lib/scope.sh lines 79-99 reach that write only after the exit code has been captured; the code it recorded is an integer rather than an empty field.
termination_without_exit_code_observed=false
termination_without_exit_code_rule=Had the process been terminated without a code, the single recorded name for that status would be the literal timeout, written in place of the exit code field so that exactly one of the two is ever present. It names how the process ended and excuses nothing: a termination leaving neither a parsable artifact nor a reason stated by the tool falls under the missing-artifact halt, while one leaving either is recorded and the run continues. Neither branch applies here.
timeout_status_literal_present=false
exit_code_and_exit_status_fields_present=exactly one, the exit code

# ---------------------------------------------------------------------------
# Timing
# ---------------------------------------------------------------------------
elapsed_seconds_measurement=scope_finish's own arithmetic over the timer scope_begin started, in whole seconds (harness/lib/scope.sh line 66 and line 81). It wrote the elapsed seconds field above.
elapsed_seconds_expected=449
elapsed_seconds_observed=621
elapsed_seconds_difference=Recorded as expected against observed, both values present. A per-tool elapsed time differing from the expected value is recorded and the run continues.
elapsed_seconds_budget_comparison=none. No time limit applies anywhere in this run. Elapsed time is a fact, and nothing here reads 621 seconds as late, slow or over budget.
started_at=not-established
finished_at=not-established
timestamps_format_if_established=ISO 8601 UTC
timestamps_reason_unestablished=Neither endpoint is recoverable from the recorded evidence. scope_begin prints its start line and scope_finish its end line to the runner's own console stream (harness/lib/scope.sh line 76 and line 90), and for this tool that stream was not captured to a file, because semgrep prints its SARIF document to stdout and run-semgrep.sh line 65 gives stdout to harness/artifacts/logs/semgrep.stdout.log. The artifact emits no startTimeUtc or endTimeUtc. Rather than record a plausible pair, both endpoints are named unestablished: a fabricated timestamp is worse than a named gap, because only the gap can be checked.
timestamps_established_instead=The window is exactly 621 seconds long, and it closed no later than 2026-08-24T23:16:57Z, the commit that recorded this evidence (8a49e3571cab822b83b8639ccbf48f8225120978).
timestamps_context=Sibling runners whose console streams were captured place this scanning wave between 2026-08-24T22:34:30Z, the start line in harness/artifacts/logs/trivy.stdout.log, and 2026-08-24T23:04:02Z, the end line in harness/artifacts/logs/opengrep.stdout.log. That is context drawn from other invocations, not a measurement of this one, and no endpoint of this invocation is derived from it.
trailer_search_scope=The whole of harness/artifacts/logs/semgrep.stdout.log was searched, not only its head and tail: the marker "elapsed seconds" occurs zero times, and the three occurrences of "exit code" all fall inside SARIF rule description text rather than in a trailer. The same markers are absent from the stderr log.

# ---------------------------------------------------------------------------
# The artifact
# ---------------------------------------------------------------------------
artifact_path=harness/artifacts/raw/semgrep.sarif
artifact_path_form=Repository-relative, the form a reader can resolve in any clone that carries this branch. The absolute artifact line above is the runner's own and is kept verbatim.
artifact_present=true
artifact_bytes_runner_recorded=40661229
artifact_bytes_measured=40661229
artifact_bytes_agree=true
artifact_bytes_measurement=stat over harness/artifacts/raw/semgrep.sarif in this clone, taken independently of the runner's own stat at harness/lib/scope.sh line 83. This record owns that number and the raw tree conforms to it.
artifact_sha256=da98395187f5eb141e1c52cf1d700f94ea7a645d0ff488c506c9fac514857d84
artifact_format=SARIF 2.1.0
artifact_shape_detection=version 2.1.0 together with a runs array, the two properties together
artifact_parses=true
artifact_parse_status=clean at the document level: the artifact loads as JSON and presents one run
artifact_records=1162
artifact_records_unit=runs[].results[], one result object per record
artifact_records_corroboration=The tool's own stderr reports "Findings: 1162 (1162 blocking)". One measurement, two witnesses; the dataset's row and rejection counts for this tool are normalization's to state, not this record's.
artifact_expected=true
artifact_status_independence=Present and parsing. That verdict and the exit code above are independent facts, recorded side by side and neither derived from the other.
artifact_absent_branch=Not applicable. Had the artifact been absent, this record would state whether harness/artifacts/logs/semgrep.stderr.log carries a reason of the tool's own for writing nothing, which is recorded as absent with the run continuing, or carries none, which is the missing-artifact halt.
artifact_bytes_in_environment_record=40660951
artifact_bytes_difference_from_environment_record=Both values recorded. The environment record's figure belongs to the provisioning run's own verify-run artifact, written under /opt/blitzy-harness/verify-run; the figure above is the artifact this run's invocation produced. This is output deliberately re-produced rather than an inherited fact contradicted, so it is recorded with its provenance and the run continues. The finding count is identical across the two at 1162.

# ---------------------------------------------------------------------------
# Tool version and interpreter, expected against observed
# ---------------------------------------------------------------------------
version_expected=1.173.0
version_observed=1.173.0
version_matches_expected=true
version_witness_gate=semgrep --version printed 1.173.0 at the gate (harness/artifacts/logs/gate-record.json, check gate.tool_version.semgrep) and printed it again on re-verification in this clone.
version_witness_artifact=The artifact's own SARIF driver name is "Semgrep OSS 1.173.0" - the invocation describing itself, independent of asking the environment.
version_drift_precedent=The expected value is 1.173.0 and the precedent provisioning carried 1.174.0, which is the named case for recording both values and continuing. The drift did not recur here; both values are recorded anyway, so this match is a checked fact rather than an assumption.
version_corrected_by_installing=false
edition=Community Edition under --oss-only with no token attached, so Pro and interfile analysis are unavailable. Recorded as configuration; the unlicensed capability is what the run measures.
interpreter_absolute_path=/opt/blitzy-tools/venvs/semgrep/bin/python
interpreter_version_expected=3.13.7
interpreter_version_observed=3.13.7
interpreter_version_matches_expected=true
interpreter_evidence=/opt/blitzy-tools/bin/semgrep is a console script whose shebang is #!/opt/blitzy-tools/venvs/semgrep/bin/python, and that interpreter reports Python 3.13.7.
interpreter_realpath=/usr/bin/python3.13
interpreter_shared_with=none. Checkov has its own environment at /opt/blitzy-tools/venvs/checkov, also reporting 3.13.7, so the two Python-hosted scanners do not share an interpreter in this provisioning.
interpreter_precedent_difference=The precedent installed Semgrep and Checkov into one shared environment. This provisioning gives each its own; the topology is recorded as read from the harness rather than assumed, both accounts present, and the run continues.
jvm=none. The runner exports no JAVA_HOME and the tool is Python-hosted, so no JDK assignment and no heap apply to this invocation.

# ---------------------------------------------------------------------------
