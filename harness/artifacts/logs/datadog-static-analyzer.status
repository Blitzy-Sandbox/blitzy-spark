record_kind=per-invocation status record for one direct invocation of one runner
record_format=one key=value pair per line, split on the first equals sign; every value is a single line; no line is a comment, so the whole file is machine-readable by the same parser harness/lib/normalize/cli.py uses
record_authored=true
record_authored_note=six of the seven keys harness/lib/scope.sh scope_finish writes (tool, exit_code, elapsed_seconds, artifact_bytes, scan_root, scan_root_source) carry their measured values unchanged. The seventh, artifact, is expressed as the repository-relative path this deliverable names, and scope_finish's own absolute value is preserved verbatim under artifact_path_recorded_by_runner. Every other key is authored from a measurement whose evidence file is named beside it
tool=datadog-static-analyzer
tool_identifier_basis=the canonical AAP 0.5.4 identifier, taken mechanically from the runner stem run-datadog-static-analyzer.sh and the artifact stem datadog-static-analyzer.sarif; never a product name
scanner_class=sast
scanner_class_varies_per_record=false
runner=harness/bin/run-datadog-static-analyzer.sh
runner_absolute_path=/tmp/blitzy/blitzy-spark/blitzy-f38258d3-f87d-44f5-bedc-af512c69e0ab-w-002_1060ea/harness/bin/run-datadog-static-analyzer.sh
runner_bytes=2080
runner_mode=755
runner_sha256=5b12ccde67ce7f571f35048d3602c031fee18c2aec3b5a9b74691d97b5f01d94
runner_edited_by_this_run=false
runner_edited_check=git diff --quiet HEAD on the runner reports no change; no runner file and no baked flag was edited, and the only levers used are environment values the runner is written to read
invocation=./harness/bin/run-datadog-static-analyzer.sh
invocation_arguments=none
invocation_form=direct, with no arguments, one tool at a time, never through an orchestrator (AAP 0.8.1)
orchestrator_used=false
orchestrator_present_in_harness_bin=false
harness_bin_runner_entries=9
argument_guard=runner lines 8-11 print a refusal to stderr and exit 64
argument_guard_precedes_all_scanning_steps=true
argument_guard_ordering_evidence=guard at lines 8-11 is the first executable statement; environment sourcing is line 16, shared-library sourcing line 18, target resolution line 28 and the tool invocation lines 46-52, so a runner handed an argument exits without resolving a target or invoking the tool
scan_target_variable=SPARK_SRC
scan_root=/opt/spark-src
scan_root_source=SPARK_SRC
scan_root_evidence=scope_resolve_target (harness/lib/scope.sh lines 29-32) read SPARK_SRC; the runner's own header records "scan root : /opt/spark-src (from SPARK_SRC)"
smoke_override_used=false
smoke_override_note=established from the runner's own record rather than assumed: scope_resolve_target names HARNESS_SMOKE_TARGET as the scan root source whenever that override is set (harness/lib/scope.sh lines 23-27), and both this record and the runner header name SPARK_SRC, so the setup-time override that redirects every runner at one small directory played no part. It is never a fallback for a real scan
working_directory=/opt/spark-src
working_directory_evidence=cd "$SCAN_ROOT" at runner line 43, equal to the resolved scan root
scope_directories=18
allowlist=harness/scope/allowlist.txt
allowlist_sha256=0013edf6cdc3a48d69aed5d7db41cc6647cfd461d348f5e1d563ba85664143d1
exit_code=0
exit_code_provenance=the tool's own code. The runner captures it at line 53 and exits with it unchanged at lines 56-57; scope_finish recorded it, and it is cross-checked against the runner trailer below
timeout_status_applies=false
timeout_status_basis=a termination that produced no exit code is the only condition that takes the timeout status name, which names the status and excuses nothing (AAP 0.8.1, 0.9.3). This process ended with a recorded code, so exit_code is the field present and the timeout field is absent; exactly one of the two appears in this file
process_terminated=false
elapsed_seconds=223
elapsed_seconds_basis=wall clock measured by the runner between scope_begin and scope_finish
elapsed_seconds_is_a_fact_not_a_budget=true
elapsed_seconds_note=no time limit applies anywhere in this pipeline, so this figure is recorded as a fact and no budget is compared against it (AAP 0.8.1)
elapsed_expected_versus_observed_owner=oss-scan-results/tool-status.md
started_at=2026-08-24T22:36:12Z
finished_at=2026-08-24T22:39:55Z
timestamps_verbatim=start 2026-08-24T22:36:12+00:00 and end 2026-08-24T22:39:55+00:00, printed by date -Is; the +00:00 offset names the same instant as the Z form above
elapsed_seconds_independent_check=finished_at minus started_at is 223 seconds, equal to elapsed_seconds
tool_reported_analysis_duration_seconds=220.936
tool_reported_analysis_duration_note=the tool's own inner measurement from its stdout summary, 2.064 seconds below the runner's wall clock; the difference is process start, rule load and SARIF write. Measured inside the tool rather than by the runner's timer, so it verifies the elapsed figure independently of the thing that produced it
artifact=harness/artifacts/raw/datadog-static-analyzer.sarif
artifact_present=true
artifact_bytes=5671091
artifact_sha256=2020ad1b3c10ce58cc30cbc01c8b31ae484ad4a92e254a64163c8462d79e37f6
artifact_format=SARIF 2.1.0
artifact_parsed=true
artifact_parse_evidence=json.load succeeds; the document carries version "2.1.0" with a runs array of one run, driver datadog-static-analyzer 0.9.1, and emits no uriBaseId and no run.originalUriBaseIds
artifact_results=6832
artifact_results_independent_check=the parsed artifact's runs[0].results length is 6832, equal to the tool's own stdout summary line "Total violations: 6832"; the count was taken from the file rather than from the summary that reports it
artifact_bytes_cross_check=the runner trailer's bytes figure, stat of the file in this tree and this record's artifact_bytes are all 5671091; this folder owns that number and the raw tree conforms to it
artifact_bytes_provisioning_record=5671090
artifact_bytes_provisioning_record_note=harness/ENVIRONMENT.md line 469 records 5,671,090 bytes for the provisioning rehearsal's own earlier invocation. That is a different invocation's output rather than an inherited fact about this one, so both values stand with their provenance and neither is altered (AAP 0.1.3)
artifact_path_recorded_by_runner=/tmp/blitzy/blitzy-spark/blitzy-f38258d3-f87d-44f5-bedc-af512c69e0ab-w-025_42e7a6/harness/artifacts/raw/datadog-static-analyzer.sarif
artifact_path_recorded_by_runner_note=preserved verbatim from the runner trailer and from the tool's own stdout "output file" line. The runner writes to HARNESS_RAW_DIR of the harness checkout it ran in; the artifact this record describes is the one measured at the repo-relative path above, in the tree carrying this record
artifact_absent_classification=not applicable, the artifact is present
version_expected=0.9.1
version_expected_revision=f76636e4
version_observed=0.9.1
version_observed_revision=f76636e43554f7f9a8e3984a31d03ec8dea5489f
version_matches_expected=true
version_match_basis=the observed version string equals the expected one and the observed revision's first eight characters are f76636e4, the abbreviated revision the expected value names
version_evidence=harness/artifacts/logs/datadog-static-analyzer.stdout.log Configuration block, lines "version : 0.9.1" and "revision : f76636e43554f7f9a8e3984a31d03ec8dea5489f", corroborated by the SARIF driver version 0.9.1 in the artifact
version_release_tag_quirk=the DataDog/datadog-static-analyzer release tag carries no leading v: tags/0.9.1 is the correct reference and tags/v0.9.1 is a 404 (AAP 0.4.1)
version_difference_handling=a difference would be recorded with both values and the run would continue (AAP 0.9.3); no difference is present
credential_dd_api_key_present=false
credential_dd_app_key_present=false
credential_state_form=booleans about presence only; no credential value appears anywhere in this file, and no reporting expression's output is copied into it
credential_state_evidence=the runner's fixed-token line "credential : DD_API_KEY=absent DD_APP_KEY=absent" in harness/artifacts/logs/datadog-static-analyzer.console.log, produced by scope_cred_state, and the same fixed-token result recorded in harness/artifacts/logs/gate-record.json
credential_expression_prints_fixed_token_only=true
credential_expression_safety=scope_cred_state (harness/lib/scope.sh lines 105-109) uses the ${VAR:+set} form only and prints exactly set or absent, so no value can reach a log this pipeline preserves verbatim
secrets_scanner=disabled
secrets_scanner_evidence=--enable-secrets false is baked at runner line 51, and the tool's own stdout reports "secrets enabled : false"
credentialed_paths_disabled=true
credentialed_paths_disabled_note=with both keys absent, this tool's credentialed secrets and AI paths stayed disabled for this invocation
ruleset_source=local captured file /opt/blitzy-harness/rules/datadog/datadog-sast-rules.json, so the scan made no API call for rules
ruleset_sha256=4f397e81414f8e9469d20abc18c80c85c722e72b9f85b8bcf69dbe34b8fef6f1
ruleset_rules=1093
ruleset_identity_comparison_owner=oss-scan-results/tool-status.md and oss-scan-results/severity-map.md
credential_fact_use=recorded as a configuration fact about this invocation only. It is never a basis for any comparison or interpretation between tools (AAP 0.3.2)
artifact_status_independent_of_exit_status=true
independence_statement=the artifact is present and parses, so the exit code is recorded here as a fact and used for nothing else; no verdict about this tool is derived from it in this file (AAP 0.5.4)
runner_trailer=harness/artifacts/logs/datadog-static-analyzer.console.log
runner_trailer_exit_code=0
runner_trailer_elapsed_seconds=223
runner_trailer_artifact_bytes=5671091
runner_trailer_agreement=true
runner_trailer_agreement_detail=the trailer's exit code, elapsed seconds and artifact byte size match this record exactly (AAP 0.6.4)
stdout_log_trailer=none
stdout_log_trailer_reason=structural. The runner redirects the tool's stdout into harness/artifacts/logs/datadog-static-analyzer.stdout.log at line 52 and prints its own header and trailer to the runner's console, captured verbatim in harness/artifacts/logs/datadog-static-analyzer.console.log
stdout_log_trailer_note=the absence of a trailer inside the tool's stdout log is not evidence of termination. A terminated process leaves no runner trailer at all; this trailer is present and carries a readable exit code, which is what settles that the process was not terminated
stdout_log_bytes=4033
stderr_log=harness/artifacts/logs/datadog-static-analyzer.stderr.log
stderr_bytes=0
stderr_stated_reason=none. The stream is empty, and no stated reason is required because the artifact is present; a stated reason is what an absent artifact would need to avoid the halt rule (AAP 0.9.2)
evidence_stdout_log=harness/artifacts/logs/datadog-static-analyzer.stdout.log
evidence_stderr_log=harness/artifacts/logs/datadog-static-analyzer.stderr.log
evidence_console_log=harness/artifacts/logs/datadog-static-analyzer.console.log
evidence_runner_metadata=harness/artifacts/logs/runner-metadata.json, tools."datadog-static-analyzer"
evidence_gate_record=harness/artifacts/logs/gate-record.json
manifest_note=this file's own byte size and sha256 are measured after it is written and carried into the manifest oss-scan-results/run-record.md owns; a file cannot carry its own digest, so neither is embedded here
