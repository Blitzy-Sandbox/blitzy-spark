# harness/artifacts/logs/opengrep.status
#
# The structured per-invocation status record for the Opengrep runner, and the
# authoritative source for its exit code and elapsed time (AAP 0.6.1).
#
# FORMAT. One field per line, each written as a name, an equals sign, then its value, as
# harness/lib/scope.sh's scope_finish writes it and harness/ENVIRONMENT.md section 8
# documents it. Every other line begins with '#' and carries no equals sign at all, so a
# reader -- or the field reader in harness/lib/normalize/cli.py, which splits each line on
# its first one -- sees fields and nothing else.
#
# PROVENANCE. Seven fields are scope_finish's own and are reproduced here exactly as the
# runner emitted them into its log directory: tool, exit_code, elapsed_seconds, artifact,
# artifact_bytes, scan_root and scan_root_source, in that relative order. Nothing the
# runner measured is restated in different words. The added fields and the prose are this
# record's own, and each names the file it was established from. Every measurement below
# was taken from the invocation this record describes; none is estimated and none is
# supplied from any other run. Where an earlier invocation measured a field differently,
# both values are on record: this file carries the superseded figures under their own
# names further down, rather than dropping either.

tool=opengrep

# THE INVOCATION. Invoked directly and individually: the runner below was run on its own,
# with no arguments, one tool at a time, never through an orchestrator (AAP 0.8.1).
# harness/bin/ holds exactly the nine runners and deliberately no orchestrator, and no
# run-all script exists or was written -- an orchestrator's continue-on-error sequencing
# would carry a run past a condition that must halt it, and it collapses per-tool
# attribution. The absolute path is the one the invocation itself fixes: harness/env.sh
# lines 14 to 26 derive HARNESS_DIR from the environment file's own location, so the raw
# directory printed in the run header (harness/artifacts/logs/opengrep.stdout.log line 3)
# identifies the harness tree the invoked script belongs to.
runner=/tmp/blitzy/blitzy-spark/blitzy-f38258d3-f87d-44f5-bedc-af512c69e0ab-w-008_c55d9d/harness/bin/run-opengrep.sh
runner_repo_relative=harness/bin/run-opengrep.sh
invocation=direct, no arguments, one tool at a time, never through an orchestrator
invocation_argument_count=0

# WHAT THE INVOCATION WAS GIVEN, AND WHAT IT WAS NOT. No runner file and no baked flag was
# edited. One environment value the runner is written to consume was set for this
# invocation -- the log directory -- and the reason is mechanical rather than
# discretionary. run-opengrep.sh line 65 passes the sarif format flag alongside the sarif
# output flag, so the engine prints the whole SARIF document to its standard output as
# well as writing it to the artifact path, and line 70 redirects that standard output into
# the log directory's opengrep.stdout.log. Left at its default the invocation would
# therefore have overwritten this record's sibling log with 73840949 bytes of SARIF, which
# is the artifact plus one trailing newline. That is not a supposition: provisioning's own
# verification run left exactly that file behind, at
# /opt/blitzy-harness/verify-run/logs/opengrep.stdout.log, one byte larger than its
# artifact. The raw directory was left at its default, so the runner wrote the deliverable
# itself, in place, at the path this repository publishes it from.
log_dir_for_this_invocation=/tmp/blitzy-harness-scratch/8/opengrep-final
log_dir_variable=HARNESS_LOG_DIR
raw_dir_for_this_invocation=default, harness/artifacts/raw
runner_file_edited=no
baked_flags_changed=no

# ARGUMENT GUARD. run-opengrep.sh lines 6 to 9 are its first executable statement: a
# runner handed an argument prints its refusal to stderr and exits 64 before the
# environment file is sourced (line 14), before the shared scope library is sourced
# (line 16), before the scan target is resolved (line 26) and before opengrep is invoked
# (lines 64 to 70). Lines 1 to 5 are the shebang and comments and execute nothing.
# Established by inspection and recorded in
# harness/artifacts/logs/runner-metadata.json under tools.opengrep.argument_guard. No
# rejection probe was run, because a blind probe against a defective runner could perform
# a real scan and contaminate the artifact tree.

# HOW THE PROCESS ENDED. The process produced an exit code of its own, so this record
# carries exit_code and carries no timeout name: exactly one of the two is present, as
# the contract requires. run-opengrep.sh captures the tool's own status at line 71 and
# exits with it unchanged at line 75, so the integer below is opengrep's rather than the
# runner's. Had the process been terminated without producing a code, AAP 0.8.1 gives
# that outcome one recorded name -- timeout -- and it would appear here under that name
# and no other; naming how a process ended never excuses a missing artifact (AAP 0.9.2).
exit_code=0

# THE EXIT CODE IS NOT A VERDICT. Artifact status and exit status are independent
# (AAP 0.5.4). The code above is recorded as a fact and used for nothing else, and no
# status verdict is derived from it anywhere in this file. A non-zero code from a tool
# that wrote a parsable artifact is an ordinary recorded condition (AAP 0.9.3) -- two of
# the nine tools are expected to exit non-zero precisely because they found something.
# Whether this tool's artifact parses is settled by the normalizer and reported in
# oss-scan-results/tool-status.md, not here.

# TIMING, AS A FACT. No time limit applies anywhere in this run (AAP 0.8.1), so the
# elapsed figure below is a recorded measurement and is held against no budget. Its
# expected-versus-observed comparison is a field of oss-scan-results/tool-status.md,
# which owns it; the expected figure is reproduced here only so that the comparison has
# both numbers in one place. Both timestamps are ISO 8601 with a +00:00 offset, that is
# UTC, exactly as the runner printed them.
elapsed_seconds=944
started_at=2026-08-25T01:23:16+00:00
finished_at=2026-08-25T01:39:00+00:00
elapsed_seconds_expected=929
elapsed_seconds_expected_source=harness/ENVIRONMENT.md line 467, corroborated by its inline-values block at line 888

# ONE MEASUREMENT, CITED TWICE. A scope_finish trailer exists for this invocation, at
# harness/artifacts/logs/opengrep.stdout.log lines 11 to 14. Its exit code line reads 0,
# its elapsed seconds line reads 944, and its artifact line reports 73840948 bytes:
# those are the same three measurements recorded here, cited twice rather than measured
# twice (AAP 0.6.4). The header's start line (line 7) and the trailer's end line
# (line 14) are the two timestamps above, verbatim. Because that trailer exists, this
# file is not the only account of how the process ended; a terminated process prints no
# trailer at all, and this record would then be the only one.
trailer_present=yes
trailer_source=harness/artifacts/logs/opengrep.stdout.log lines 11 to 14
#
# The elapsed figure was checked independently of the trailer rather than copied from it:
# the difference between the finished_at and started_at timestamps is 944 seconds
# exactly, arrived at by date arithmetic over the header and footer, where the runner
# arrived at the same number from two date(1) readings in scope_finish
# (harness/lib/scope.sh lines 79 to 90). Two routes, one value.
elapsed_seconds_independent_check=finished_at minus started_at is 944 seconds; agrees

# THE ARTIFACT. The invocation wrote its one artifact, and scope_finish measured that
# file on disk with stat at completion (harness/lib/scope.sh lines 82 to 86). An artifact
# that had not been written would have been recorded as the literal MISSING instead, as
# harness/artifacts/logs/osv-scanner.status shows for the tool that legitimately wrote
# none. So this is not the artifact-absent case of AAP 0.5.4 and the missing-artifact
# halt rule of AAP 0.9.2 is not in play. This folder owns the byte count below, and
# harness/artifacts/raw/ conforms to it -- here by construction rather than by transfer,
# because the runner's raw directory was its default and the file scope_finish measured
# is the file this repository publishes. Nothing was copied, moved, edited, reformatted,
# re-serialized, truncated, sorted, filtered or deduplicated: the bytes in the deliverable
# are the bytes the engine wrote there.
artifact=/tmp/blitzy/blitzy-spark/blitzy-f38258d3-f87d-44f5-bedc-af512c69e0ab-w-008_c55d9d/harness/artifacts/raw/opengrep.sarif
artifact_bytes=73840948
artifact_expected_path=harness/artifacts/raw/opengrep.sarif
artifact_format=SARIF 2.1.0
artifact_sha256=302b515b77a052dc4217a03cc9d1e0bc7bc0259beed928ca36cbcf48a503102a
artifact_written_in_place=yes
artifact_present_in_this_checkout_at_write_time=yes
artifact_bytes_authority=this record owns the number and harness/artifacts/raw/opengrep.sarif conforms to it

# WHAT THE ARTIFACT CONTAINS, MEASURED RATHER THAN ASSUMED. The shape test is the
# conjunction AAP 0.5.4 states and harness/lib/normalize/shape.py implements, and nothing
# else was consulted: a version of 2.1.0 together with a runs array. Both hold. The count
# unit is runs[].results[], one result object per record, which is what
# harness/lib/normalize/reconcile.py counts for a SARIF producer; counting it over this
# file returns the same integer as the engine's own closing summary line, so the record
# count is two routes to one number rather than a restatement. The driver block names the
# engine and its version, which is how the artifact identifies its own producer.
artifact_records=1322
artifact_records_count_unit=runs[].results[]
artifact_records_independent_check=harness/lib/normalize/reconcile.py count_records returns 1322; the engine's own summary line reports 1322 findings; agrees
artifact_runs=1
artifact_driver_name=Opengrep OSS
artifact_driver_semantic_version=1.27.1
artifact_driver_rules=2002
artifact_shape_detected=sarif
artifact_absent_without_stated_reason=no

# THE TOOL'S OWN WORDS. Read regardless, so the classification can be checked instead of
# taken on trust. harness/artifacts/logs/opengrep.stderr.log carries the engine's own scan
# status over 4095 files with 2006 Code rules, its note about the reach it applied, its
# partial-analysis count, and its closing summary line. All four are reproduced verbatim
# below. The reduced-reach line is a fact to record (AAP 0.9.3), never a defect to repair:
# untracked files under a scope directory are skipped by default, and no runner was edited
# to change that. What the summary count means for the dataset is tool-status.md's field,
# not this one's.
findings_summary_line=Ran 1138 rules on 4095 files: 1322 findings.
reduced_reach_in_tool_words=Scan was limited to files tracked by git.
partial_analysis_in_tool_words=Partially scanned: 46 files only partially analyzed due to parsing or internal Opengrep errors
rules_available_in_tool_words=Scanning 4095 files tracked by git with 2006 Code rules:

# THE RULESET. Read from the runner's own header line rather than from any expectation.
# The identity matches the one harness/artifacts/logs/runner-metadata.json records under
# tools.opengrep.ruleset_or_feed_identity, so this tool's counts are comparable with the
# provisioning record on the ruleset axis, and no not-comparable status is set.
ruleset_location=/opt/blitzy-harness/rules/opengrep-rules
ruleset_commit=f1d2b562b414783763fd02a6ed2736eaed622efa
ruleset_commit_matches_expected=yes
ruleset_config_argv_tokens=58

# DETERMINISM, ESTABLISHED BY REPRODUCTION. This runner's output over this tree is
# byte-identical across independent invocations, which is a measured property of this
# provisioning rather than an assumption about the engine. Three invocations were compared
# by digest: provisioning's verification run, recorded in harness/ENVIRONMENT.md line 467
# and left at /opt/blitzy-harness/verify-run/raw/opengrep.sarif; a first invocation of
# this run, written to a scratch directory; and the invocation this record describes,
# which wrote the deliverable. All three produce the same sha256 above, the same 73840948
# bytes, and a stderr that differs in no byte at all, including its summary line. Elapsed
# time is the one figure that moves -- 929, 950 and 944 seconds -- which is host load
# rather than output.
determinism_invocations_compared=3
determinism_verdict=byte-identical across all three, one sha256
determinism_evidence=sha256sum over the three artifacts returned 302b515b77a052dc4217a03cc9d1e0bc7bc0259beed928ca36cbcf48a503102a for each; diff over the three stderr logs reported no difference

# A SUPERSEDED EARLIER INVOCATION, RECORDED RATHER THAN DROPPED. An earlier invocation of
# this same runner, in a different clone of this branch, measured three of these fields
# differently: 1065 elapsed seconds, 1239 findings, and an artifact of 63695205 bytes. Its
# artifact was never committed to this branch, and it is not the deliverable. Both values
# are on record here because the run's authority rule resolves the difference rather than
# hiding it: the expected-values table governs every field it carries, and it carries this
# tool's finding count as 1322 at exit 0 -- the figure the clone instantiation
# instructions state, the figure harness/ENVIRONMENT.md line 467 states together with an
# artifact of 73840948 bytes, and the figure harness/artifacts/logs/runner-metadata.json
# already records under tools.opengrep.reach.in_tool_words. Three invocations reproduce
# it byte for byte and the earlier one does not, so the earlier one is the recorded
# difference and the anchored figure is the deliverable. Its 83 missing findings and
# 10145743 fewer bytes are consistent with rule and file pairs abandoned under the
# runner's own per-target limit while the host was loaded, which the engine does not
# itemise; that mechanism is offered as the likely account and is not claimed as measured.
superseded_invocation_elapsed_seconds=1065
superseded_invocation_findings=1239
superseded_invocation_artifact_bytes=63695205
superseded_invocation_artifact_committed=no
superseded_invocation_disposition=recorded difference; not the deliverable

# THE TREE THAT WAS SCANNED. The runner takes its target from the environment and never
# from the working directory: harness/lib/scope.sh lines 22 to 35 read SPARK_SRC and
# export the resolved root, and the runner then works from that root
# (run-opengrep.sh line 50). The two fields below are the runner's own account of the root
# it resolved, which is what makes the root in
# harness/artifacts/logs/runner-metadata.json independently checkable rather than
# self-asserted. The setup-time smoke override was unset -- had it been set, the source
# below would name HARNESS_SMOKE_TARGET, and that is never a fallback for a real scan.
# The root was verified to be the pinned tree before the invocation: git rev-parse HEAD in
# it returned 59b8a4489c878fa3a9aa6b7fbae760f2fc80eb9d.
scan_root=/opt/spark-src
scan_root_source=SPARK_SRC
scan_root_commit=59b8a4489c878fa3a9aa6b7fbae760f2fc80eb9d
smoke_override_state=unset
scope_dirs=18
allowlist_sha256=0013edf6cdc3a48d69aed5d7db41cc6647cfd461d348f5e1d563ba85664143d1

# CREDENTIALS. No credential value appears in this file, and none can reach it: the
# runner prints only the fixed token scope_cred_state produces (harness/lib/scope.sh
# lines 105 to 109, which evaluate the plus form alone and never the dash form whose set
# arm would expand to the variable's own value), and the run header records the variable
# as absent. Opengrep reads no credential in any case.
credential_semgrep_app_token=absent

# FOR THE MANIFEST. oss-scan-results/run-record.md owns the manifest of both artifact
# trees, with a byte size and a sha256 for every file in them, this one included. Those
# two values cannot be stated inside the file they describe, so they are measured on this
# file as written and carried into that manifest; this record makes no claim about its
# own size or digest. The artifact's own size and digest are stated above, measured on the
# file the runner wrote.
