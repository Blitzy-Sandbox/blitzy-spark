STEP 3 - The same identity, measured again by an independent reader, and compared
  The comparison the run turns on, made once more by a different tool than the
  one used in STEP 2 and against the pair parsed out of the frontend's own
  record rather than typed in here. The record states its pair twice, in two
  spellings; the reader collects BOTH spellings and requires the distinct set to
  hold exactly one byte size and one sha256, because a record that states two
  identities cannot adjudicate a load. A mismatch halts.

$ python3 - <<PY
import hashlib, os, re, pathlib
named = pathlib.Path(os.environ["HARNESS_CPG"])
resolved = named.resolve()
size_follow = named.stat().st_size
size_nofollow = named.lstat().st_size
h = hashlib.sha256()
with open(resolved, "rb") as f:
    for chunk in iter(lambda: f.read(1 << 20), b""):
        h.update(chunk)
obs = h.hexdigest()
text = pathlib.Path("harness/artifacts/logs/cpg-frontend.log").read_text()
sizes = sorted({m.group(1) for m in re.finditer(r"(?im)^\s*(?:bytes|byte size)\s*:\s*(\d+)\s*$", text)})
shas  = sorted({m.group(1).lower() for m in re.finditer(r"(?im)^\s*sha256\s*:\s*([0-9a-fA-F]{64})\s*$", text)})
print("named path                :", named)
print("resolved path             :", resolved)
print("named path is a symlink   :", named.is_symlink())
print("size WITHOUT following    :", size_nofollow, "(recorded to be discarded)")
print("size WITH following       :", size_follow, "(the measurement of record)")
print("sha256 of the target      :", obs)
print("record byte sizes found   :", ",".join(sizes), "-> distinct", len(sizes))
print("record sha256 values found:", ",".join(shas), "-> distinct", len(shas))
rec_size = int(sizes[0]); rec_sha = shas[0]
print("recorded at write time    : bytes=%d sha256=%s" % (rec_size, rec_sha))
print("byte size matches         :", "YES" if size_follow == rec_size else "NO")
print("sha256 matches            :", "YES" if obs == rec_sha else "NO")
print("verdict                   :", "PASS - identity re-verified" if (size_follow == rec_size and obs == rec_sha) else "HALT - identity mismatch")
PY
