STEP 4 - IDENTITY RE-VERIFICATION with symlink-following semantics
  The check AAP 0.6.4 and 0.8.2 require before every load. The comparison is made
  by parsing the recorded pair out of cpg-frontend.log and measuring the file
  live, so neither side is typed in. Symlink-following is not a detail: the named
  path is a 33-byte symlink, and 'stat -c %s' on it would record 33 - the length
  of the target path string - and a record carrying 33 would describe nothing at
  all. The wrong measurement is shown below explicitly, to be discarded.

$ python3 - <<'PY'
import re, subprocess, hashlib, os, json
frontend = "harness/artifacts/logs/cpg-frontend.log"
txt = open(frontend, encoding="utf-8", errors="replace").read()
blk = txt.split("THE IDENTITY OF RECORD",1)[1].split("THE PRE-EXISTING-PATH CASE",1)[0]
rec_size = re.search(r"byte size\s*:\s*(\d+)", blk).group(1)
rec_sha  = re.search(r"sha256\s*:\s*([0-9a-f]{64})", blk).group(1)
rec_ino  = re.search(r"dev:inode ([0-9]+:[0-9]+)", blk).group(1)
link = os.environ["HARNESS_CPG"]
sh = lambda c: subprocess.run(c, shell=True, capture_output=True, text=True).stdout.strip()
resolved  = sh(f'readlink -f "{link}"')
live_size = sh(f'stat -Lc %s "{link}"')          # symlink-FOLLOWING
link_only = sh(f'stat -c %s "{link}"')           # the wrong measurement, shown to be discarded
live_ino  = sh(f'stat -Lc %d:%i "{link}"')
tgt_ino   = sh(f'stat -c %d:%i "{resolved}"')
h = hashlib.sha256()
with open(link, "rb") as fh:                      # open() follows the symlink
    for chunk in iter(lambda: fh.read(1 << 22), b""): h.update(chunk)
live_sha = h.hexdigest()
print(f"source of the recorded pair        : {frontend} -> THE IDENTITY OF RECORD")
print(f"link path (AAP name / $HARNESS_CPG): {link}")
print(f"resolved target                    : {resolved}")
print(f"size, NO -L (to be discarded)      : {link_only}   <- length of the target path string, never the graph's size")
print()
print(f"{'field':<22} {'RECORDED (cpg-frontend.log)':<66} {'OBSERVED (measured here)':<66} verdict")
for name, rec, live in (("byte size (stat -Lc %s)", rec_size, live_size),
                        ("sha256 (link followed)", rec_sha, live_sha),
                        ("dev:inode", rec_ino, live_ino)):
    print(f"{name:<22} {rec:<66} {live:<66} {'MATCH' if rec==live else 'MISMATCH'}")
print()
print(f"same-file proof: link(followed)={live_ino}  target={tgt_ino}  -> {'SAME FILE' if live_ino==tgt_ino else 'DIFFERENT FILES'}")
ok = (rec_size==live_size) and (rec_sha==live_sha) and (rec_ino==live_ino) and (live_ino==tgt_ino)
print()
print("IDENTITY RE-VERIFICATION:", "PASS - the bytes this load will read are the bytes cpg-frontend.log describes" if ok
      else "HALT - AAP 0.6.4/0.8.2: a load against different bytes than the record describes")
PY
