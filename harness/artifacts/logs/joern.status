#
# ----------------------------------------------------------------------------
# harness/artifacts/logs/joern.status
# The structured per-invocation status record for the Joern runner, and the
# THIRD of the four separate records of a heap-bound JVM invocation.
# ----------------------------------------------------------------------------
#
# WHAT THIS FILE IS
#
#   AAP 0.5.4 requires that for each of the four heap-bound JVM invocations --
#   the jimple2cpg frontend build, the importCpg verification load, THIS RUNNER,
#   and the Stage 5 capability probe -- the command, the JDK major version and
#   the heap actually used are recorded SEPARATELY. This file is that record for
#   the Stage 3 Joern runner, and it carries those three as three distinct
#   fields rather than as one summary line.
#
#   The seven lines above it are the runner's own account, written verbatim by
#   scope_finish in harness/lib/scope.sh at lines 91 to 99. They are preserved
#   byte for byte and are not re-derived, re-ordered or restated. Everything
#   below them is this record's addition.
#
# FORMAT, AND WHY THE COMMENTS LOOK LIKE THIS
#
#   One field per line: a key, then the first equals sign on the line, then the
#   value. A line carrying no equals sign is commentary. No comment line in this
#   file contains one, deliberately: harness/lib/normalize/cli.py reads this file
#   at its _runner_status function by partitioning each line on the first equals
#   sign, skipping every line without one, and letting the last occurrence of a
#   key win. Writing a comment that happened to contain an equals sign would
#   manufacture a field. So the seven runner keys appear exactly once each, and
#   every field added here carries a name that collides with none of them.
#
#   Two consequences of that same parser are load-bearing and are honoured
#   above. The exit code is left as a bare integer, because a status file whose
#   exit code cannot be read is classified as a termination that produced no
#   exit code. And scan_root and scan_root_source are left exactly as the runner
#   wrote them, because the normalizer halts on a runner whose record shows it
#   resolved a tree other than the pinned one, or shows it ran under the
#   setup-time smoke override.
#
# PROVENANCE RULE
#
#   Every value below is measured, or read from a named file, and the evidence
#   index at the foot names the file and the lines. Nothing is copied from an
#   expectation. Where a check could not be performed, that is said plainly
#   instead of being filled with a plausible value: an unmeasured number in a
#   record is worse than a named gap, because nothing downstream can tell the
#   two apart.
#
# ----------------------------------------------------------------------------
# IDENTITY AND CLASSIFICATION
# ----------------------------------------------------------------------------
#
#   The canonical tool identifier and the scanner class come from the AAP 0.5.4
#   class table, which fixes scanner_class per tool with Trivy as the single
#   exception. Joern is sast.
#
record_kind=per-invocation runner status record
record_stage=Stage 3, the nine runners
record_position=third of the four heap-bound JVM invocations
scanner_class=sast
scanner_class_varies_per_record=no
#
# ----------------------------------------------------------------------------
# THE RUNNER, AND HOW IT WAS INVOKED
# ----------------------------------------------------------------------------
#
#   AAP 0.8.1 requires each runner invoked directly, with no arguments, one at a
#   time, and never through an orchestrator, whose continue-on-error sequencing
#   would carry the run past a condition that must halt it and would collapse
#   per-tool attribution. harness/bin/ holds exactly the nine runners and no
#   orchestrator, so none was available to use and none was used.
#
#   The argument guard was established by inspection rather than by a probe: a
#   blind probe against a defective runner could perform a real scan and
#   contaminate the artifact tree. The guard is the first executable statement
#   in the script, so it precedes the environment sourcing at line 27, the
#   shared library sourcing at line 29, the target resolution at line 50 and the
#   tool invocation at line 69.
#
runner_path=harness/bin/run-joern.sh
runner_path_absolute_as_invoked=/tmp/blitzy/blitzy-spark/blitzy-f38258d3-f87d-44f5-bedc-af512c69e0ab-w-031_2e6517/harness/bin/run-joern.sh
runner_invocation_form=direct
runner_arguments_passed=none
runner_invoked_one_at_a_time=yes
runner_invoked_through_orchestrator=no
orchestrator_present_in_harness_bin=no
argument_guard_lines=harness/bin/run-joern.sh lines 19-22
argument_guard_exit_code=64
argument_guard_is_first_executable_statement=yes
argument_guard_precedes_all_scanning_steps=yes
argument_guard_established_by=inspection
argument_rejection_probe_performed=no
argument_rejection_probe_reason=inspection settled the ordering, so no probe was needed and none was run against the artifact tree
runner_working_directory=/tmp/blitzy-harness-scratch/31/joern-run
runner_working_directory_rationale=Joern exposes no workspace flag and writes its workspace into whatever directory it runs from, so the runner works in the per-clone scratch directory and never in the repository
runner_working_directory_equals_scan_root=no
clone_index_of_invocation=31
scan_target_variable=SPARK_SRC
scan_target_value_set=/opt/spark-src
resolved_scan_root_verified=yes
scan_input_is_the_graph=yes
scan_input_variable=HARNESS_CPG
#
#   This runner is the one whose real input is the code-property graph rather
#   than a directory tree. The resolved scan root is recorded for provenance and
#   because the normalizer checks it, not because a tree was walked.
#
# ----------------------------------------------------------------------------
# TIMING -- RECORDED AS FACTS, AGAINST NO BUDGET
# ----------------------------------------------------------------------------
#
#   AAP 0.8.1 imposes no time limit anywhere. Elapsed time is a fact, and the
#   expected figure below is recorded beside the observed one as a comparison,
#   never as a threshold. The observed elapsed seconds and the interval between
#   the recorded start and end agree exactly, which is the internal consistency
#   check on both.
#
started_at=2026-08-24T22:41:02Z
finished_at=2026-08-24T22:58:56Z
started_at_verbatim=2026-08-24T22:41:02+00:00
finished_at_verbatim=2026-08-24T22:58:56+00:00
elapsed_seconds_from_timestamps=1074
elapsed_seconds_internally_consistent=yes
elapsed_seconds_expected=734
elapsed_seconds_comparison=observed 1074 against expected 734; a difference recorded under AAP 0.9.3 and not a halt
time_limit_applied=none
#
# ----------------------------------------------------------------------------
# EXIT DISPOSITION -- EXACTLY ONE OF THE TWO
# ----------------------------------------------------------------------------
#
#   AAP 0.5.4 admits either an exit code, the tool's own integer, or the single
#   name given to a termination that produced no exit code. Exactly one is
#   present. This process exited with a code, so the code is recorded above and
#   no timeout field appears anywhere in this file. The timeout name is defined
#   below for completeness because a terminated process leaves no stdout
#   trailer, which would make this file the only record of how it ended.
#
termination_mode=exited with its own code
exit_code_expected=0
exit_code_comparison=matches
exit_code_is_the_tools_own=yes
exit_code_transformed_by_runner=no
timeout_status_recorded=no
timeout_status_literal_when_applicable=exit_status: timeout
timeout_rule=the name records how a process ended and excuses nothing; a termination that left neither a parsable artifact nor a no-work reason of the tool's own falls under the missing-artifact halt rule of AAP 0.9.2
#
#   Exit 78 is its own category and did not occur. run-joern.sh guards its input
#   at lines 44 to 48 and, if the graph is missing or does not resolve to a
#   file, calls scope_fail, which prints a diagnostic naming the fault to stderr
#   and exits 78 before any scanning. AAP 0.1.1 classifies that as a
#   configuration fault to fix at the gate. It is therefore neither an
#   absent-artifact classification nor a scan failure, and had it happened it
#   would have been recorded as a fault to correct rather than as an outcome to
#   classify.
#
exit_78_observed=no
exit_78_category=configuration fault to fix at the gate
exit_78_distinct_from_absent_artifact_classification=yes
exit_78_distinct_from_scan_failure=yes
exit_78_guard_lines=harness/bin/run-joern.sh lines 44-48, via scope_fail at harness/lib/scope.sh lines 17-20
#
# ----------------------------------------------------------------------------
# THE ARTIFACT
# ----------------------------------------------------------------------------
#
#   AAP 0.5.4 makes artifact status and exit status independent. Here the
#   artifact is present and parses, so the exit code is recorded as a fact and
#   used for nothing else.
#
#   The byte size is owned by this folder and the raw tree conforms to it. Three
#   independent readings agree: the runner's own artifact_bytes field above, the
#   trailer in joern.stdout.log which prints the size in its artifact line, and
#   a direct measurement of the file on disk in this checkout.
#
artifact_path_repo_relative=harness/artifacts/raw/joern.json
artifact_present=yes
artifact_bytes_measured_on_disk=354343
artifact_bytes_expected=354343
artifact_bytes_agreement=runner status field, stdout trailer and on-disk measurement all read 354343
artifact_sha256=deb0cd765602cc0be2bf4ffa03cc8a39cccfb5e17fb0631d094d24af55204a4a
artifact_format=native JSON with a findings array
artifact_json_parses=yes
artifact_findings_count=692
artifact_findings_count_expected=692
artifact_findings_count_source=length of the findings array, read from the artifact; the runner independently reports the same figure in its stdout line naming the file it wrote
artifact_envelope_keys=tool, tool_version, cpg, graph, query_set, queries, findings
artifact_written_only_to_raw_tree=yes
#
# ----------------------------------------------------------------------------
# VERSION -- EXPECTED AGAINST OBSERVED, READ FROM THE STARTUP BANNER
# ----------------------------------------------------------------------------
#
#   Joern exposes no version flag and its REPL blocks on an open stdin, so the
#   version is read from the startup banner with stdin closed. AAP 0.9.3 makes a
#   tool version differing from the expected value a record-and-continue
#   condition, with both values recorded. Here they agree.
#
#   Where the banner was NOT found matters, and is stated rather than glossed.
#   joern.stderr.log, which this record depends on, carries no banner: the
#   runner invokes joern with a script, and that path prints the script's own
#   progress rather than the interactive banner. So the eight lines in that file
#   are the script execution trace, and the banner reading comes from the two
#   places it was actually taken.
#
version_expected=4.0.607
version_observed=4.0.607
version_comparison=matches
version_read_method=startup banner with stdin closed
version_banner_literal=Version: 4.0.607
version_evidence_primary=harness/artifacts/logs/joern.preflight.log lines 203-206, the pre-load gate reading
version_evidence_independent=re-read live during the writing of this record, from a scratch directory outside the repository so the workspace side effect could not land in the checkout
version_present_in_stderr_log=no
version_absent_from_stderr_log_reason=the runner invokes joern with a script rather than interactively, and that path prints no banner; joern.stderr.log holds the script execution trace only
version_corroboration=the artifact's own tool_version field reads 4.0.607, which agrees but is the runner's claim rather than an independent reading and is recorded as corroboration only
#
# ----------------------------------------------------------------------------
# THE BAKED QUERY SET -- COUNTED FROM THE RUNNER, NOT FROM THE EXPECTATION
# ----------------------------------------------------------------------------
#
#   AAP 0.4.2 expects a fifty-eight query bundle bounded to six structural
#   queries and states that the actual baked count is read from the runner. What
#   is there is six queries baked directly into the script the runner names, and
#   that is what is recorded. The expectation is kept beside it so a reader can
#   see the difference rather than having to reconstruct it.
#
#   The bound governs how much work each query is asked to do, never which files
#   or modules are in scope. Each query takes one more than its bound and reports
#   whether it reached it, so truncation is observed rather than assumed; none of
#   the six reached its bound on this invocation.
#
query_set_file=harness/lib/joern-scan.sc
query_set_baked_query_count=6
query_set_baked_query_count_source=counted from the runner's baked script, by the query declarations it contains
query_set_baked_query_count_expected=the AAP expects a fifty-eight query bundle bounded to six structural queries and directs that the actual count be read from the runner
query_set_query_ids=joern-process-exec,joern-unsafe-deserialization,joern-reflection-forname,joern-message-digest,joern-cipher-getinstance,joern-xml-factory
query_set_bound_per_query=2000
query_set_bound_variable=HARNESS_JOERN_QUERY_BOUND
query_set_bound_default_line=harness/bin/run-joern.sh line 36
query_set_bound_reached_any=no
query_set_returned_per_query=joern-process-exec 55, joern-unsafe-deserialization 178, joern-reflection-forname 412, joern-message-digest 23, joern-cipher-getinstance 11, joern-xml-factory 13
query_set_returned_total=692
query_set_load_mechanism=importCpg
query_set_importcpg_occurrences=3
query_set_importcode_occurrences=0
query_set_scope_effect=none; the bound limits traversal work, not the files or modules in scope
#
# ----------------------------------------------------------------------------
# HEAP-BOUND JVM INVOCATION, FIELD 1 OF 3 -- THE COMMAND
# ----------------------------------------------------------------------------
#
#   The command as the runner issues it, with the shell quoting the script
#   itself carries. Joern's launcher does not forward system properties to a
#   script, so the graph path, the artifact path and the traversal bound are
#   passed through the environment rather than on the command line.
#
command=JAVA_HOME="$JAVA_HOME_21" SL_LOGGING_LEVEL="${SL_LOGGING_LEVEL:-WARN}" HARNESS_SCAN_CPG="$CPG_REAL" HARNESS_SCAN_OUT="$ART" HARNESS_SCAN_BOUND="$BOUND" joern --script "$SCRIPT" -J-Xmx"$HARNESS_JOERN_HEAP" < /dev/null > "$OUT" 2> "$ERR"
command_source_lines=harness/bin/run-joern.sh lines 67-71
command_resolved_heap_flag=-J-Xmx64g
command_resolved_script=harness/lib/joern-scan.sc
command_stdin=closed, from /dev/null, because the REPL blocks on an open stdin
command_logging_level=WARN, because the default level floods the artifact
command_targets_on_command_line=none
command_launcher=/opt/blitzy-tools/bin/joern, the provisioning wrapper that pins the 21 JDK rather than the joern-cli launcher, which would take whatever java is first on PATH
#
# ----------------------------------------------------------------------------
# HEAP-BOUND JVM INVOCATION, FIELD 2 OF 3 -- THE JDK MAJOR VERSION
# ----------------------------------------------------------------------------
#
#   Every Joern invocation runs under major 21, the version the pinned release
#   documents as its tested requirement. AAP 0.8.2 and 0.9.2 make a MAJOR
#   misassignment a halt; a patch difference with the correct major is recorded
#   with both values and the run continues. The major was parsed from the JVM's
#   own properties rather than eyeballed from the banner, and it was read live
#   while this record was written as well as at the pre-load gate.
#
jdk_major=21
jdk_major_required=21
jdk_major_verdict=PASS
jdk_major_source=java.specification.version, parsed from the JVM's own property output rather than read off the banner
jdk_home=/opt/blitzy-tools/jdk/jdk-21.0.12.1+1
jdk_version_string=openjdk version "21.0.12.1" 2026-08-18 LTS
jdk_vm_version=21.0.12.1+1-LTS
jdk_expected_build=Temurin 21.0.12.1+1
jdk_patch_comparison=matches the expected build, so no patch difference to record
jdk_pinned_by=the runner sets JAVA_HOME to JAVA_HOME_21 and asserts that JDK is usable before invoking; the joern wrapper on PATH pins the same JDK independently
jdk_misassignment_rule=a wrong major halts the run; a patch difference with the correct major is recorded with both values
#
# ----------------------------------------------------------------------------
# HEAP-BOUND JVM INVOCATION, FIELD 3 OF 3 -- THE HEAP ACTUALLY USED
# ----------------------------------------------------------------------------
#
#   This is the field a reviewer checks first, because a heap below the minimum
#   produces a run that looks entirely plausible and a graph whose silence
#   cannot be told apart from a clean result. AAP 0.8.2 makes the rule one-way:
#   raising a heap is permitted and reported, lowering one is not.
#
#   A DIVERGENCE FROM THE STATED PRECEDENT, recorded rather than smoothed over.
#   The precedent this record was written against describes a runner defaulting
#   JAVA_OPTS to a forty-eight gigabyte maximum, below the mandated minimum, and
#   would have required that default to be overridden. The provisioned runner
#   here does not work that way. It reads HARNESS_JOERN_HEAP and applies it as
#   its own maximum-heap flag at line 70, printing the value at line 60, and the
#   environment file defaults that variable to sixty-four gigabytes at line 85.
#   So the forty-eight gigabyte default is not in effect on two independent
#   counts: JAVA_OPTS is unset, and this runner never consults it in any case.
#
#   The honest consequence is that no raise was required and none was made. The
#   value in effect already meets the minimum, and it arrived through the
#   runner's own documented environment override, which AAP 0.6.5 classes as a
#   runtime value rather than a configuration edit. Recording a raise that did
#   not happen would be a fabricated measurement, so the mechanism, the value
#   and the reason no raise was needed are recorded instead.
#
#   The value was not merely reserved. The host was shown to COMMIT it, by a
#   pre-touch run that touches every page, which is strictly stronger than
#   reservation. That proof was taken at the pre-load gate and again live while
#   this record was written, both under the 21 JDK. No value above sixty-four
#   gigabytes was used, so no further commit proof is owed.
#
heap_used=64g
heap_used_bytes=68719476736
heap_used_flag=-J-Xmx64g
heap_minimum_required=64g
heap_meets_minimum=yes
heap_mechanism=HARNESS_JOERN_HEAP, the runner's own documented environment override, applied at harness/bin/run-joern.sh line 70
heap_mechanism_classification=runtime value, not a configuration edit; no runner file and no baked flag was changed
heap_value_source=the provisioned default at harness/env.sh line 85
heap_raise_required=no
heap_raise_made=no
heap_raise_reason=the provisioned default already meets the mandated minimum, so there was nothing to raise
heap_48g_precedent_default_in_effect=no
heap_48g_precedent_evidence_1=JAVA_OPTS is unset in the sourced environment, recorded at the pre-load gate
heap_48g_precedent_evidence_2=this runner reads HARNESS_JOERN_HEAP rather than JAVA_OPTS, so the precedent default could not apply even if the variable were set
heap_lowered=no
heap_direction_rule=raising is permitted and reported; lowering produces a truncated graph whose silence cannot be told apart from a clean result
heap_commit_proof_command=java -Xms64g -Xmx64g -XX:+AlwaysPreTouch -version
heap_commit_proof_exit=0
heap_commit_proof_strength=pre-touch touches every page, which is strictly stronger than reservation
heap_commit_proof_evidence=harness/artifacts/logs/joern.preflight.log lines 212-214, taken before the load; re-taken live under the same JDK while this record was written
heap_above_minimum_used=no
heap_above_minimum_commit_proof_owed=no
heap_in_stream_measurement=harness/artifacts/logs/joern.stdout.log line 12, where the runner prints the heap it is about to use into its own console stream
#
# ----------------------------------------------------------------------------
# GRAPH IDENTITY, RE-VERIFIED IMMEDIATELY BEFORE THIS LOAD
# ----------------------------------------------------------------------------
#
#   AAP 0.6.4 and 0.8.2 require the graph's byte size and sha256, recorded at
#   write time, to be RECOMPUTED AND COMPARED before every load, with each check
#   logged, and a mismatch halts: a load against different bytes than the record
#   describes produces conclusions about a graph nobody has. This is that check
#   for this load. Verification is independent of the thing verified, so both
#   values were measured from the bytes on disk rather than copied from any
#   record that states them.
#
#   The measurement follows the symlink. The named path is a thirty-three byte
#   symlink, so a size taken without following it reports the length of the link
#   target string rather than the graph. That wrong measurement is recorded here
#   explicitly so it cannot be mistaken for the right one, exactly as the
#   frontend log does at its own step. Both names -- the path the AAP names and
#   the path the environment exports -- are proved to be one file by device and
#   inode, not merely by two hashes agreeing.
#
graph_identity_verified=yes
graph_identity_verdict=PASS
graph_identity_halt_triggered=no
graph_path_named=harness/cpg/spark.cpg
graph_path_named_kind=symlink
graph_path_resolved=/opt/blitzy-harness/cpg/spark.cpg
graph_path_resolved_kind=regular file
graph_both_names_same_file=yes
graph_both_names_dev_inode=1048752:37891488
graph_bytes_recorded_at_write_time=541255894
graph_bytes_observed_before_load=541255894
graph_bytes_match=yes
graph_bytes_measurement_of_record=size taken with symlink-following semantics
graph_bytes_link_only_measurement_discarded=33
graph_sha256_recorded_at_write_time=26d327ccee096aa4c8d67018b32669f2a318331cf873922286774734177fcffc
graph_sha256_observed_before_load=26d327ccee096aa4c8d67018b32669f2a318331cf873922286774734177fcffc
graph_sha256_match=yes
graph_identity_write_time_reference=harness/artifacts/logs/cpg-frontend.log, byte size at STEP 23 and sha256 at STEP 26, with the link-only measurement shown at STEP 22 to be discarded
graph_identity_check_evidence=harness/artifacts/logs/joern.preflight.log PART 2, comparison at line 147 and verdict at line 167
graph_identity_checked_at=2026-08-24T22:38:33Z
graph_identity_checked_before_load_at=2026-08-24T22:41:02Z
graph_identity_reconfirmed_while_writing_this_record=yes
graph_identity_runner_in_stream_lines=harness/artifacts/logs/joern.stdout.log lines 8-10, where the runner prints the path, its resolution, the byte size and the sha256 it is about to load
graph_loaded_methods=1397339
graph_loaded_type_declarations=119691
graph_loaded_files=45037
graph_loaded_methods_greater_than_zero=yes
graph_load_mechanism=importCpg
graph_rebuilt_by_this_invocation=no
#
# ----------------------------------------------------------------------------
# GATE CONDITIONS OBSERVED BEFORE THE LOAD
# ----------------------------------------------------------------------------
#
#   The smoke override redirects every runner at one small directory and exists
#   for setup-time verification only. Leaving it set would silently scan the
#   wrong thing, and it is never a fallback, so its state is recorded rather
#   than assumed.
#
smoke_override_state=unset
java_opts_state=unset
pinned_tree_head=59b8a4489c878fa3a9aa6b7fbae760f2fc80eb9d
pinned_tree_head_matches_pin=yes
allowlist_sha256=0013edf6cdc3a48d69aed5d7db41cc6647cfd461d348f5e1d563ba85664143d1
allowlist_scope_directories=18
allowlist_read_for_targeting_by_this_runner=no
allowlist_read_note=this runner's input is the graph, so the allowlist is read only incidentally, for the directory count the header prints
#
# ----------------------------------------------------------------------------
# CLASSIFICATION RULES APPLIED
# ----------------------------------------------------------------------------
#
artifact_status_and_exit_status_independent=yes
exit_code_used_for=recorded as a fact and nothing else, because the artifact is present and parses
absent_artifact_classification_applicable=no
absent_artifact_classification_reason=the artifact is present, so the completed-with-nothing-in-scope against failed distinction does not arise for this tool
tool_stated_no_work_reason=not applicable
parse_status_owner=oss-scan-results/tool-status.md, rendered from the normalization results; this record states only that the artifact parses as JSON and how many findings it carries
#
# ----------------------------------------------------------------------------
# CROSS-REFERENCES -- WHAT AGREES, AND WHAT IS STILL OUTSTANDING
# ----------------------------------------------------------------------------
#
#   AAP 0.6.4 requires that a count appearing in two documents be one
#   measurement cited twice rather than two measurements. The trailer agreement
#   below is exactly that check for this file against the runner's own stream.
#
#   One required cross-reference cannot be performed yet, and is named rather
#   than asserted. The findings count in the artifact is the left side of the
#   identity that the normalizer's parsed and rejected counts must sum to.
#   normalize-run.json does not exist at the time this record is written, so the
#   measured left side is recorded and the check is left standing against the
#   file that will own the right side. Claiming an equality that was not
#   observed would be the fabricated measurement this record exists to avoid.
#
stdout_trailer_exit_code=0
stdout_trailer_elapsed_seconds=1074
stdout_trailer_artifact_bytes=354343
stdout_trailer_agreement=exact on all three values against the fields recorded above
stdout_trailer_source=harness/artifacts/logs/joern.stdout.log trailer, duplicated verbatim in harness/artifacts/logs/joern.runner.console.log
reconciliation_left_side_findings=692
reconciliation_identity=the findings count must equal the rows emitted for joern plus the records rejected for joern
reconciliation_right_side_source=harness/artifacts/logs/normalize-run.json
reconciliation_right_side_available=no
reconciliation_status=outstanding; the left side is measured and recorded here, and the equality is to be checked once the normalizer run record exists
probe_findings_combined_with_this_runner=no
probe_separation_note=Joern appears twice by design, as one of the nine runners and as the subject of the Stage 5 capability probe. The probe writes outside the raw artifact tree and contributes no dataset row, so nothing in this record mixes the two; reading the double appearance as a duplication would corrupt both counts
manifest_owner=oss-scan-results/run-record.md, which owns the byte size and sha256 of every file in both artifact trees, this one included
#
# ----------------------------------------------------------------------------
# CREDENTIALS
# ----------------------------------------------------------------------------
#
#   A credential-reporting expression must print a fixed token, because these
#   logs are preserved verbatim and one common shell form yields the variable's
#   own value when it is set. This runner has no such expression at all: it
#   reads no credential and prints no credential line. Recorded as none rather
#   than as an empty string, and no value of any kind appears in this file.
#
credential_expression=none
credential_read_by_this_runner=none
credential_value_present_in_this_file=none
#
# ----------------------------------------------------------------------------
# EVIDENCE INDEX -- EVERY NUMBER ABOVE NAMES A FILE THAT EXISTS
# ----------------------------------------------------------------------------
#
#   harness/artifacts/logs/joern.stdout.log
#       header lines 1-14 for the scan root, allowlist digest, scope directory
#       count, graph path and identity, JDK, heap and query set with its bound;
#       the graph-loaded line for the method, type-declaration and file counts;
#       six query lines for the per-query returns and the bound flags; and the
#       trailer for the exit code, elapsed seconds, artifact and end time.
#   harness/artifacts/logs/joern.stderr.log
#       the script execution trace, and the evidence that this path prints no
#       startup banner, which is why the version reading is sourced elsewhere.
#   harness/artifacts/logs/cpg-frontend.log
#       the write-time identity pair this record compares against.
#   harness/artifacts/logs/joern.preflight.log
#       the pre-load gate: the environment and smoke-override state, the graph
#       identity recomputation and comparison, the JDK major, the version banner
#       and the pre-touch commit proof.
#   harness/artifacts/logs/joern.runner.console.log
#       the runner's console stream, header and trailer together.
#   harness/artifacts/logs/runner-metadata.json
#       the runner facts read at the gate and finalised after the clone.
#   harness/artifacts/raw/joern.json
#       the artifact whose byte size, digest and findings count are recorded.
#   harness/bin/run-joern.sh and harness/lib/joern-scan.sc and harness/env.sh
#       the command, the argument and graph guards, the baked query set and its
#       bound, and the heap default.
#   harness/ENVIRONMENT.md
#       the expected exit code, elapsed time, finding count and artifact size.
#

