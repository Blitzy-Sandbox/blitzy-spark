  STEP 4 OF 9 - THE COMPARISON, computed independently of the query that loads it

    The block below re-measures the graph in Python - a streaming sha256 over the
    resolved target - and parses BOTH records itself. It shares no code with the
    query's own stage C, so the query's guard and this check are two independent
    readings rather than one reading printed twice. The load was permitted only
    because the record of account agrees on both fields.
$ python3 - <<PY
import hashlib, os, pathlib, re
named = pathlib.Path(os.environ["HARNESS_CPG"])
target = named.resolve()
size = target.stat().st_size
h = hashlib.sha256()
with target.open("rb") as fh:
    for chunk in iter(lambda: fh.read(1 << 20), b""):
        h.update(chunk)
digest = h.hexdigest()

def account_record(p):
    t = pathlib.Path(p).read_text(errors="replace")
    b = re.search(r"^graph bytes\s*:\s*(\d+)\s*\$", t, re.M)
    s = re.search(r"^graph sha256\s*:\s*([0-9a-f]{64})\s*\$", t, re.M)
    return (int(b.group(1)), s.group(1))

def repo_record(p):
    t = pathlib.Path(p).read_text(errors="replace")
    b = re.search(r"^bytes:\s*(\d+)\s*\$", t, re.M)
    s = re.search(r"^sha256:\s*([0-9a-f]{64})\s*\$", t, re.M)
    return (int(b.group(1)), s.group(1))

acc_path = "/opt/blitzy-harness/provision-log/cpg-frontend.log"
repo_path = "harness/artifacts/logs/cpg-frontend.log"
acc = account_record(acc_path)
rep = repo_record(repo_path)

print("named path (HARNESS_CPG)      :", named)
print("resolved target               :", target)
print("measured, symlink-following   : %d bytes  sha256 %s" % (size, digest))
print("record of account             :", acc_path)
print("  states                      : %d bytes  sha256 %s" % acc)
print("  byte size agrees            :", size == acc[0])
print("  sha256 agrees               :", digest == acc[1])
print("repo-relative record          :", repo_path)
print("  states                      : %d bytes  sha256 %s" % rep)
print("  byte size agrees            :", size == rep[0])
print("  sha256 agrees               :", digest == rep[1])
print()
print("VERDICT: the load may proceed only if BOTH lines for the record of account read True.")
print("both agree for the record of account:", size == acc[0] and digest == acc[1])
print("The repo-relative record is a committed deliverable describing an EARLIER")
print("provisioning's graph; its pair is recorded here rather than discarded, and the")
print("divergence is a property of which bytes provisioning left on this host.")
