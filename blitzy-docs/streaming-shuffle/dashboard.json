{
  "id": null,
  "uid": "streaming-shuffle",
  "title": "Streaming Shuffle",
  "description": "Observability dashboard for the Apache Spark opt-in Streaming Shuffle backend (org.apache.spark.shuffle.streaming). A 2x2 grid of the four shuffle.streaming.* executor metrics, scraped from the Spark executor Prometheus endpoint /metrics/executors/prometheus. The buffer-utilization gauge marks the 80% spill threshold that triggers MemorySpillManager disk spill.",
  "tags": [
    "spark",
    "shuffle",
    "streaming",
    "blitzy"
  ],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Buffer Utilization (shuffle.streaming.bufferUtilizationPercent)",
      "description": "GAUGE - current per-partition in-memory buffer utilization as a percent (0-100) of the configured budget, aggregated as the cluster-wide maximum. The red threshold at 80% marks the spillThreshold default that triggers MemorySpillManager disk spill (spark.shuffle.streaming.spillThreshold). Canonical metric: shuffle.streaming.bufferUtilizationPercent.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "minVizHeight": 75,
        "minVizWidth": 75,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max({__name__=~\".*shuffle.streaming.bufferUtilizationPercent.*\"})",
          "refId": "A",
          "legendFormat": "Max buffer utilization %",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Spill Count (shuffle.streaming.spillCount)",
      "description": "COUNTER - cumulative number of disk spills performed by MemorySpillManager when buffer utilization reached the spill threshold, summed per executor instance. Spilling is the designed graceful-degradation behavior (not an error). Canonical metric: shuffle.streaming.spillCount.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (instance) ({__name__=~\".*shuffle.streaming.spillCount.*\"})",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Backpressure Events (shuffle.streaming.backpressureEvents)",
      "description": "COUNTER - cumulative number of backpressure throttling events raised by the BackpressureProtocol token-bucket/heartbeat flow control, summed per executor instance. Elevated counts indicate consumers throttling producers under load (expected operational signal). Canonical metric: shuffle.streaming.backpressureEvents.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (instance) ({__name__=~\".*shuffle.streaming.backpressureEvents.*\"})",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Partial Read Invalidations (shuffle.streaming.partialReadInvalidations)",
      "description": "COUNTER - cumulative number of partial-read invalidations raised by StreamingShuffleReader on producer connection timeout (5s), each surfacing a FetchFailedException for lineage-based recompute. Any value greater than 0 is a failure/invalidation signal (red). Canonical metric: shuffle.streaming.partialReadInvalidations.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (instance) ({__name__=~\".*shuffle.streaming.partialReadInvalidations.*\"})",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    }
  ]
}
