{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "description": "External Grafana dashboard template for Apache Spark Streaming Shuffle observability. Renders the four `streamingShuffle` Source metrics scraped from Spark's Prometheus exposition (the executor endpoint /metrics/executors/prometheus, or the PrometheusServlet sink). This is a portable documentation artifact — it is NOT a Spark Web UI asset. Bind your own Prometheus data source through the `datasource` template variable; no panel edits are required. Metric names and PromQL query shapes are kept byte-identical to blitzy-docs/streaming-shuffle/observability.md so the docs and dashboard never diverge.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Streaming Buffer Utilization (%)",
      "description": "Per-executor buffered-partition memory utilization, expressed as a percentage of the streaming buffer budget. The streaming writer spills the largest/LRU partitions to disk once utilization exceeds spark.shuffle.streaming.spillThreshold (default 80%). Backed by the gauge metric streamingShuffle.bufferUtilizationPercent.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "utilization %",
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "max by (instance) ({__name__=~\"metrics_.*_streamingShuffle_bufferUtilizationPercent_(Value|Number)\"})",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Spill Count",
      "description": "Cumulative number of streaming-buffer spill-to-disk events per executor. Spills occur when buffer utilization crosses spark.shuffle.streaming.spillThreshold; the spilled partitions are persisted to BlockManager DISK_ONLY. Backed by the counter metric streamingShuffle.spillCount.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "spills",
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (instance) ({__name__=~\"metrics_.*_streamingShuffle_spillCount_Count\"})",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Backpressure Events",
      "description": "Cumulative number of backpressure signals raised per executor when consumers fall behind producers and the token-bucket rate limiter throttles the stream. Sustained growth indicates the consumer is not keeping pace and may trigger the slow-consumer fallback to sort-based shuffle. Backed by the counter metric streamingShuffle.backpressureEvents.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "events",
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (instance) ({__name__=~\"metrics_.*_streamingShuffle_backpressureEvents_Count\"})",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Partial-Read Invalidations",
      "description": "Cumulative number of partial-read invalidations per executor. A reduce-side reader increments this when a producer connection times out (5s), atomically discarding the partial read and throwing FetchFailedException so the DAG scheduler recomputes upstream. Any non-zero rate signals producer instability. Backed by the counter metric streamingShuffle.partialReadInvalidations.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "invalidations",
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (instance) ({__name__=~\"metrics_.*_streamingShuffle_partialReadInvalidations_Count\"})",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["spark", "shuffle", "streaming", "observability"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus data source",
        "description": "Prometheus data source that scrapes Spark's streamingShuffle metrics (via /metrics/executors/prometheus or the PrometheusServlet sink).",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": [],
        "skipUrlSync": false
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Apache Spark — Streaming Shuffle",
  "uid": "spark-streaming-shuffle",
  "version": 1,
  "weekStart": ""
}
