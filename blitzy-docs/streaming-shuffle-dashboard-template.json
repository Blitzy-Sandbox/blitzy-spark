{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source exposing Spark streaming shuffle metrics.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "expr": "changes(shuffle_streaming_fallbackActivations{executor_id=~\"$executor\"}[1m]) > 0",
        "hide": false,
        "iconColor": "red",
        "name": "Fallback Activated",
        "showIn": 0,
        "step": "",
        "titleFormat": "StreamingShuffleFallbackPolicy triggered",
        "textFormat": "Streaming shuffle fell back to sort-based shuffle for executor {{executor_id}}"
      }
    ]
  },
  "description": "Observability dashboard for Apache Spark Streaming Shuffle (opt-in ShuffleManager selected via spark.shuffle.manager=streaming). Displays the four shuffle.streaming.* Dropwizard metrics surfaced via Prometheus: bufferUtilizationPercent (Gauge), spillCount (Counter), backpressureEvents (Counter), partialReadInvalidations (Counter). Also includes fallback activation annotations emitted by StreamingShuffleFallbackPolicy. Template dashboard — import and select your Prometheus data source. Generated as part of the Streaming Shuffle Observability Rule deliverable (AAP §0.7.7).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Buffer Utilization (%)",
      "description": "Per-executor buffer utilization as reported by StreamingShuffleMetrics (Gauge[Double]). Warning thresholds align with the AAP-specified spill trigger at 80%: 50% informational, 80% spill-trigger threshold, 95% critical memory pressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shuffle_streaming_bufferUtilizationPercent{executor_id=~\"$executor\"}",
          "legendFormat": "{{executor_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "Buffer Utilization (%)",
            "axisGridShow": true,
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spill Count (cumulative and rate)",
      "description": "Cumulative count of spill events triggered by MemorySpillManager when buffer utilization crossed the configurable spillThreshold (default 80%). Query A shows the cumulative counter; Query B shows the 5-minute rolling rate for trend visibility.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shuffle_streaming_spillCount{executor_id=~\"$executor\"}",
          "legendFormat": "{{executor_id}} (total)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(shuffle_streaming_spillCount{executor_id=~\"$executor\"}[5m])",
          "legendFormat": "{{executor_id}} (rate/5m)",
          "refId": "B",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "Spill Events",
            "axisGridShow": true,
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Backpressure Events (rate/s)",
      "description": "Per-second rate of backpressure events emitted by BackpressureProtocol when consumer acknowledgments fall behind producer send rate, or when the token-bucket rate limiter throttles outgoing blocks.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(shuffle_streaming_backpressureEvents{executor_id=~\"$executor\"}[5m])",
          "legendFormat": "{{executor_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "Events per second",
            "axisGridShow": true,
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Partial Read Invalidations (rate/s)",
      "description": "Per-second rate of partial read invalidations emitted by StreamingShuffleReader when producer connection timeouts are detected (default 5 s) and upstream recomputation is triggered via the DAG scheduler.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(shuffle_streaming_partialReadInvalidations{executor_id=~\"$executor\"}[5m])",
          "legendFormat": "{{executor_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "Invalidations per second",
            "axisGridShow": true,
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Fallback Activation Events",
      "description": "Events where StreamingShuffleFallbackPolicy delegated a shuffle to the held SortShuffleManager. Forward-compatible metric: panel will remain empty until StreamingShuffleFallbackPolicy starts emitting shuffle_streaming_fallbackActivations. The dashboard-level annotation 'Fallback Activated' overlays marker pins on every time series when a fallback event occurs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "changes(shuffle_streaming_fallbackActivations{executor_id=~\"$executor\"}[5m])",
          "legendFormat": "{{executor_id}} fallbacks/5m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "Fallback activations",
            "axisGridShow": true,
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 16
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "spark",
    "shuffle",
    "streaming",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus",
        "description": "Prometheus data source that exposes Spark streaming shuffle metrics via the PrometheusServlet.",
        "query": "prometheus",
        "regex": "",
        "hide": 0,
        "skipUrlSync": false,
        "current": {},
        "refresh": 1
      },
      {
        "name": "executor",
        "type": "query",
        "label": "Executor",
        "description": "Filter the dashboard to one or more executor IDs. Defaults to 'All' (regex '.*').",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(shuffle_streaming_bufferUtilizationPercent, executor_id)",
        "query": {
          "query": "label_values(shuffle_streaming_bufferUtilizationPercent, executor_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "shuffle_id",
        "type": "query",
        "label": "Shuffle ID",
        "description": "Filter the dashboard to one or more shuffle IDs when the shuffle_id Prometheus label is exposed. Defaults to 'All' (regex '.*').",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(shuffle_streaming_spillCount{executor_id=~\"$executor\"}, shuffle_id)",
        "query": {
          "query": "label_values(shuffle_streaming_spillCount{executor_id=~\"$executor\"}, shuffle_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Spark Streaming Shuffle — Observability Dashboard",
  "uid": "spark-streaming-shuffle",
  "version": 1,
  "weekStart": ""
}
